<?xml version="1.0" encoding="UTF-8"?>
<!--
  Canonical XSD for FormosanBank XML files.
  Migrated from xml_template.dtd in Phase 4.5.

  Adds four constraints the DTD could not express:
  1. FORM/@kindOf enumeration (original | standard | alternate).
     Replaces Python rule v016_known_kindOf_values.
  2. PHON/@kindOf enumeration (original | standard).
  3. AUDIO/@start and @end as xs:double (non-numeric values rejected at
     schema time; the v050 try/except branch becomes unreachable).
  4. xs:unique id uniqueness across S, W, M within a single file (V039).

  Order remains strict (xs:sequence); xs:all is deferred because XSD 1.0
  prohibits unbounded children under xs:all.

  xml_template.dtd is retained on disk as a fallback; remove it only
  after the XSD has been validated in production.
-->
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    elementFormDefault="unqualified"
    attributeFormDefault="unqualified">

  <!-- xml.xsd is a local copy of the 2009 W3C xml.xsd. The W3C URL
       returns 403 in some CI/offline environments, breaking validator
       startup; bundling the local copy avoids that. The xml.xsd file
       attributes to W3C and the XML Working Group in its own header. -->
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="xml.xsd"/>

  <!-- Simple types -->

  <xs:simpleType name="FORM_kindOf_Type">
    <xs:restriction base="xs:string">
      <xs:enumeration value="original"/>
      <xs:enumeration value="standard"/>
      <xs:enumeration value="alternate"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PHON_kindOf_Type">
    <xs:restriction base="xs:string">
      <xs:enumeration value="original"/>
      <xs:enumeration value="standard"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TRANSL_kindOf_Type">
    <xs:restriction base="xs:string">
      <xs:enumeration value="original"/>
      <xs:enumeration value="standard"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- UNCLEAR: empty marker element used inline within FORM/PHON/TRANSL
       to indicate audio that was attempted but could not be transcribed
       (or, in TRANSL, text that could not be translated). Distinct from
       V010 (S with no FORM at all, i.e. "not yet transcribed") because
       UNCLEAR is a positive assertion: "we tried and failed."
       Token-counting tools should NOT count UNCLEAR as a token.
       Added 2026-06-08 to schematize a pattern already in published
       data (WilangYutasVideos, YeddaPalemeqBlog). -->

  <xs:complexType name="UNCLEAR_Type"/>

  <!-- FORM/PHON/TRANSL: mixed content. Each carries free text and may
       additionally contain zero or more <UNCLEAR/> children, allowing
       both whole-tier unclarity (<FORM><UNCLEAR/></FORM>) and partial
       inline unclarity (<FORM>foo <UNCLEAR/> bar</FORM>). Was
       simpleContent (text-only) prior to 2026-06-08. -->

  <xs:complexType name="FORM_Type" mixed="true">
    <xs:sequence>
      <xs:element name="UNCLEAR" type="UNCLEAR_Type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="kindOf" type="FORM_kindOf_Type" use="required">
      <xs:annotation>
        <xs:documentation>
          Which tier this FORM belongs to. `original` is the text as the
          actual source prints it, preserving the source's orthographic
          choices. `standard` is that content transliterated into
          FormosanBank's common standard orthography. `alternate` is a
          spelling variant of a sibling FORM on the same node (POL-028);
          it requires a non-alternate sibling (V149) and must overlap it
          or stay in proportion to it (V150).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="notes" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Human-readable qualification of this FORM — a transcription
          note, a review status, or what the source actually printed
          where the tier departs from it.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- TRANSL: mixed content; xml:lang is optional at XSD level (V023 is a
       Python rule because the DTD also could not express it as required
       on TRANSL only). -->

  <xs:complexType name="TRANSL_Type" mixed="true">
    <xs:sequence>
      <xs:element name="UNCLEAR" type="UNCLEAR_Type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute ref="xml:lang">
      <xs:annotation>
        <xs:documentation>
          ISO 639-3 code for the language this translation is *into* —
          not the language of the text (V023, V035).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="kindOf" type="TRANSL_kindOf_Type">
      <xs:annotation>
        <xs:documentation>
          Only meaningful at W and M level, where a TRANSL carries a
          gloss: `original` is the source's own gloss, `standard` a
          standardized one. Forbidden on an S-level TRANSL, which is a
          free translation with no such axis (V151).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ver" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Discriminates multiple translations into the same language on
          one parent (POL-025). When a parent has two or more
          same-language TRANSLs, all but one must carry this (V085). The
          allowed values are owned by V084's allowlist — currently
          `{"alt"}` — deliberately not duplicated as an XSD enumeration,
          so there is one place to update.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="notes" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Human-readable qualification of this translation — translator,
          review status, or a literal reading kept out of the
          translation text itself (POL-024).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- PHON: mixed content; kindOf is optional but, when present, must be
       "original" or "standard". -->

  <xs:complexType name="PHON_Type" mixed="true">
    <xs:sequence>
      <xs:element name="UNCLEAR" type="UNCLEAR_Type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="kindOf" type="PHON_kindOf_Type">
      <xs:annotation>
        <xs:documentation>
          Which FORM tier this IPA representation was derived from,
          `original` or `standard` (V071). A parent may carry at most
          one PHON per value (V072).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- AUDIO: empty element; start/end are optional but typed as xs:double
       so non-numeric values are rejected by the schema. -->

  <xs:complexType name="AUDIO_Type">
    <xs:attribute name="start" type="xs:double">
      <xs:annotation>
        <xs:documentation>
          Start offset in seconds within the referenced audio file.
          Typed `xs:double`, so non-numeric values fail at schema time.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation>
        <xs:documentation>
          End offset in seconds within the referenced audio file. Must
          be greater than `start` (V054).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="file" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Name of the audio file this element refers to. Audio files are
          gitignored and fetched per corpus by `download_audio_data.sh`.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="url" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          URL the audio can be fetched from, where it is addressed
          remotely rather than by filename.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Provenance of the recording — for example the video or
          broadcast a clip was extracted from.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- M element: FORM, PHON, AUDIO, TRANSL may appear in ANY order via
       xs:choice. Per the design (and user direction 2026-05-31):
       sibling-element ordering within a parent is NOT a validation
       concern. Cardinality of each kindOf is enforced by Python rules
       (v015 for FORM kindOf=original; v072 for duplicate PHON kindOf).
       M may have zero or more of each type (M without a FORM is
       unusual but not currently disallowed at the schema level —
       V011/V012 cover the required-FORM-on-W/M case for FORM specifically). -->

  <xs:complexType name="M_Type">
    <xs:sequence>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element name="FORM" type="FORM_Type"/>
        <xs:element name="PHON" type="PHON_Type"/>
        <xs:element name="AUDIO" type="AUDIO_Type"/>
        <xs:element name="TRANSL" type="TRANSL_Type"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Morpheme identifier, unique across all S, W and M within the
          file (V039).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Grammatical class label for the morpheme. The schema imposes
          no controlled vocabulary.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sclass" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Grammatical subclass label for the morpheme. The schema
          imposes no controlled vocabulary.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- W element: sibling order of FORM/PHON/AUDIO/TRANSL/M is NOT
       enforced — relaxed 2026-06-01 per user direction. Previously M
       was constrained to the trailing position; this is now a soft
       documentation convention only. If M-at-end ever needs to be
       hard-enforced again, add a Python rule. -->

  <xs:complexType name="W_Type">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="FORM" type="FORM_Type"/>
      <xs:element name="PHON" type="PHON_Type"/>
      <xs:element name="AUDIO" type="AUDIO_Type"/>
      <xs:element name="TRANSL" type="TRANSL_Type"/>
      <xs:element name="M" type="M_Type"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Word identifier, unique across all S, W and M within the file
          (V039).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Grammatical class label for the word. The schema imposes no
          controlled vocabulary.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sclass" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Grammatical subclass label for the word. The schema imposes no
          controlled vocabulary.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- S element: sibling order of FORM/PHON/AUDIO/TRANSL/W is NOT
       enforced — relaxed 2026-06-01 per user direction (AUDIO may
       appear anywhere within S, including after W children, to
       accommodate corpora where the per-S audio clip is declared
       trailing the word-level decomposition). Previously W was
       constrained to the trailing position; this is now a soft
       documentation convention only.
       V010 (SOFT): S is allowed to have 0 sibling content (e.g.,
       diarized-audio S elements that have not yet been transcribed).
       The Python rule v010_count_s_without_form counts and reports them.
       W/M still require at least one FORM (V011/V012 are HARD). -->

  <xs:complexType name="S_Type">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="FORM" type="FORM_Type"/>
      <xs:element name="PHON" type="PHON_Type"/>
      <xs:element name="AUDIO" type="AUDIO_Type"/>
      <xs:element name="TRANSL" type="TRANSL_Type"/>
      <xs:element name="W" type="W_Type"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Sentence identifier, unique across all S, W and M within the
          file (V039). Part of the public identifier surface (POL-037).
          A sentence split from another for optional material takes the
          original's id plus `-opt` (POL-026).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="audio_url" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Source URL for this sentence's audio, where the recording is
          addressed by URL rather than by file.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Sentence-specific provenance — page, column, or editorial note
          about where this particular sentence came from.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- TEXT element (root): AUDIO and S are both optional at the schema
       level. The canonical shapes are:
         - text corpus: <TEXT> [<AUDIO/>] <S>+ </TEXT> (one or more S,
           optional top-level AUDIO)
         - audio-only file: <TEXT> <AUDIO file="..."/> </TEXT> (single
           AUDIO child, no S; used for recordings not yet transcribed —
           relaxed 2026-06-03 per user direction after Whitehorn_Collection)
       The fully empty case (no AUDIO and no S) is not meaningful but
       isn't caught here; XSD 1.0 can't express "at least one of these
       two must be present" without UPA violations, and an empty TEXT
       is obvious on inspection. Add a Python rule if it ever shows up
       in real data.

       xs:unique on TEXT enforces V039: id values must be unique across
       all S, W, and M elements within a single file. lxml/libxml2 supports
       flat union paths (no predicates) in xs:selector. -->

  <xs:element name="TEXT">
    <xs:complexType>
      <xs:sequence>
        <!-- AUDIO/@maxOccurs relaxed to unbounded 2026-06-08: untranscribed
             companion files (e.g. Wilang Yutas) emit one top-level <AUDIO>
             per gap, so a single TEXT may legitimately carry several. The
             text-corpus case still uses 0 or 1; this just no longer caps
             it at 1. -->
        <xs:element name="AUDIO" type="AUDIO_Type" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="S" type="S_Type" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>
            Stable public identifier for this text, unique across the
            published bank (V081). Renaming one breaks external
            references — see POL-037.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="citation" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>
            Human-readable bibliographic citation for the source.
            Required on every published TEXT (POL-042).
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="BibTeX_citation" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>
            The same source as a BibTeX entry, for machine reuse.
            Required on every published TEXT.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="copyright" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>
            The rights statement under which this text is published.
            Required on every published TEXT; POL-042 through POL-045
            govern what may go here.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute ref="xml:lang" use="required">
        <xs:annotation>
          <xs:documentation>
            ISO 639-3 code for the language of the Formosan-text tiers,
            validated against `QC/validation/iso-639-3.txt` (V035). Note
            `trv` covers the whole Seediq family: `trv` plus
            `dialect="Truku"` is Truku, anything else is Seediq.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="source" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Free-text provenance for the whole text — the publication,
            page, URL or collection it came from.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="audio" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Name or identifier of the audio collection this text's
            recordings belong to. Present only for corpora with audio.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="glottocode" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Glottolog code for the variety, where one is useful
            alongside the ISO 639-3 code.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dialect" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Dialect label, from the canonical list in `dialects.csv`
            (V036). Together with `xml:lang` this determines language
            identity and which reference materials apply.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>

    <xs:unique name="unique_id_within_file">
      <xs:selector xpath=".//S | .//W | .//M"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
