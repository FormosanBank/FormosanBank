        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E008Bb">
            <FORM kindOf="original">Mgay ku pila sunan ka yaku.</FORM>
            <TRANSL xml:lang="zho">我要給你錢。</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E008Cb">
            <FORM kindOf="original">Ini nami skuxul hyaan ka yami.</FORM>
            <TRANSL xml:lang="zho">我們不喜歡他。</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E011Fb">
            <FORM kindOf="original">Ninima ka patas gaga?</FORM>
            <TRANSL xml:lang="zho">那本書是誰的？</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E021Ab">
            <FORM kindOf="original">Hiya o tqian mu.</FORM>
            <TRANSL xml:lang="zho">我睡覺的地方是那裡。</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E027Ab">
            <FORM kindOf="original">Ga su hmuya?</FORM>
            <TRANSL xml:lang="zho">你正在做什麼？</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E027Cb">
            <FORM kindOf="original">Nii mtaqi ka hiya.</FORM>
            <TRANSL xml:lang="zho">他正在睡覺。</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C03_E034b">
            <FORM kindOf="original">Mtgsa laqi ka Lowking.</FORM>
            <TRANSL xml:lang="zho">Lowking 將要教小孩</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E011K">
            <FORM kindOf="original">Lowking o msipaq knan.</FORM>
            <TRANSL xml:lang="zho">Lowking 要打我。</TRANSL>
        </S>
        <S id="HSU_LOWKING_TRUKU_WORDFORMATION_2008_C01_E011L">
            <FORM kindOf="original">Patas gaga o ntama.</FORM>
            <TRANSL xml:lang="zho">那本書是爸爸的。</TRANSL>
        </S>
