    <S id="S-L00284-e01">
        <FORM kindOf="original" notes="printed p.013 l.22">i sa'akawagay</FORM>
        <FORM kindOf="standard">i sa'akawangay</FORM>
        <PHON kindOf="standard">i saʡakawaŋaj</PHON>
        <TRANSL xml:lang="zho">在天空</TRANSL>
    </S>
    <S id="S-L00290-e01">
        <FORM kindOf="original" notes="printed p.013 l.29–p.013 l.31">aki kako tala</FORM>
        <FORM kindOf="standard">aki kaku tala</FORM>
        <PHON kindOf="standard">aki kak[o|u] taɾa</PHON>
        <TRANSL xml:lang="zho">我不要去那兒</TRANSL>
    </S>
    <S id="S-L00290-e02">
        <FORM kindOf="original" notes="printed p.013 l.29–p.013 l.31">aki o manikaway</FORM>
        <FORM kindOf="standard">aki u manikaway</FORM>
        <PHON kindOf="standard">aki [o|u] manikawaj</PHON>
        <TRANSL xml:lang="zho">天！我那麼窮！</TRANSL>
    </S>
    <S id="S-L00334-e01">
        <FORM kindOf="original" notes="printed p.015 l.13">ci 'alay</FORM>
        <FORM kindOf="standard">ci 'alay</FORM>
        <PHON kindOf="standard">ʦi ʡaɾaj</PHON>
        <TRANSL xml:lang="zho">挎著</TRANSL>
    </S>
    <S id="S-L00360-e01">
        <FORM kindOf="original" notes="printed p.015 l.41–p.015 l.42">ano komaem kako to talacay 'i, ma'alim ko wadis ako</FORM>
        <FORM kindOf="standard">anu kumaem kaku tu talacay 'i, ma'alim ku wadis aku</FORM>
        <PHON kindOf="standard">an[o|u] k[o|u]maəm kak[o|u] t[o|u] taɾaʦaj ʡi maʡaɾim k[o|u] wadis ak[o|u]</PHON>
        <TRANSL xml:lang="zho">我吃鳳梨時，牙齒發酸</TRANSL>
    </S>
    <S id="S-L00629-e01">
        <FORM kindOf="original" notes="printed p.023 l.35–p.023 l.36">o maan kora niapidan iso?</FORM>
        <FORM kindOf="standard">u maan kura niapidan isu?</FORM>
        <PHON kindOf="standard">[o|u] maan k[o|u]ra niapidan is[o|u]</PHON>
        <TRANSL xml:lang="zho">你手中掌承什麼東西？</TRANSL>
    </S>
    <S id="S-L00845-e01">
        <FORM kindOf="original" notes="printed p.030 l.11">ma'atkekay a tamdaw</FORM>
        <FORM kindOf="standard">ma'atkekay a tamdaw</FORM>
        <PHON kindOf="standard">maʡatkəkaj a tamdaw</PHON>
        <TRANSL xml:lang="zho">背突出的人</TRANSL>
    </S>
    <S id="S-L01470-e01">
        <FORM kindOf="original" notes="printed p.049 l.26–p.049 l.28; source: 可 7,34">"Cagaw sa ci Yiso a pasakakarayan cda'ah sa"</FORM>
        <FORM kindOf="standard">"Cangaw sa ci Yisu a pasakakarayan cda'ah sa"</FORM>
        <PHON kindOf="standard">ʦaŋaw sa ʦi jis[o|u] a pasakakarajan ʦdaʡaħ sa</PHON>
        <TRANSL xml:lang="zho">＂耶穌抬頭望天，深深地軟了一口氣＂</TRANSL>
    </S>
    <S id="S-L01653-e01">
        <FORM kindOf="original" notes="printed p.055 l.11; no translation in the source">ci'edaw ko sowal</FORM>
        <FORM kindOf="standard">ci'edaw ku suwal</FORM>
        <PHON kindOf="standard">ʦiʡədaw k[o|u] s[o|u]waɾ</PHON>
    </S>
    <S id="S-L02182-e01">
        <FORM kindOf="original" notes="printed p.071 l.29; no translation in the source">cohacoh sa</FORM>
        <FORM kindOf="standard">cuhacuh sa</FORM>
        <PHON kindOf="standard">ʦ[o|u]ħaʦ[o|u]ħ sa</PHON>
    </S>
    <S id="S-L02468-e01">
        <FORM kindOf="original" notes="printed p.081 l.31–p.081 l.32">dada kiso</FORM>
        <FORM kindOf="standard">dada kisu</FORM>
        <PHON kindOf="standard">dada kis[o|u]</PHON>
        <TRANSL xml:lang="zho">請你優先</TRANSL>
    </S>
    <S id="S-L02468-e02-1">
        <FORM kindOf="original" notes="printed p.081 l.31–p.081 l.32; alternative 1 of 2 in the source: dada kiso = tanam kiso">dada kiso</FORM>
        <FORM kindOf="standard">dada kisu</FORM>
        <PHON kindOf="standard">dada kis[o|u]</PHON>
        <TRANSL xml:lang="zho">你看看 = 試試看 (指威嚇人的意思)</TRANSL>
    </S>
    <S id="S-L02468-e02-2">
        <FORM kindOf="original" notes="printed p.081 l.31–p.081 l.32; alternative 2 of 2 in the source: dada kiso = tanam kiso">tanam kiso</FORM>
        <FORM kindOf="standard">tanam kisu</FORM>
        <PHON kindOf="standard">tanam kis[o|u]</PHON>
        <TRANSL xml:lang="zho">你看看 = 試試看 (指威嚇人的意思)</TRANSL>
    </S>
    <S id="S-L02476-e01">
        <FORM kindOf="original" notes="printed p.082 l.07–p.082 l.08">pakadadagoyananay a pifotig</FORM>
        <FORM kindOf="standard">pakadadanguyananay a pivuting</FORM>
        <PHON kindOf="standard">pakadadaŋ[o|u]jananaj a pi[b|v][o|u]tiŋ</PHON>
        <TRANSL xml:lang="zho">坐竹筏而釣魚</TRANSL>
    </S>
    <S id="S-L03234-e01">
        <FORM kindOf="original" notes="printed p.106 l.13; no translation in the source">fafoy no lotok</FORM>
        <FORM kindOf="standard">vavuy nu lutuk</FORM>
        <PHON kindOf="standard">[b|v]a[b|v][o|u]j n[o|u] ɾ[o|u]t[o|u]k</PHON>
    </S>
    <S id="S-L03882-e01">
        <FORM kindOf="original" notes="printed p.125 l.31">mafitro kako</FORM>
        <FORM kindOf="standard">mavitru kaku</FORM>
        <PHON kindOf="standard">ma[b|v]itr[o|u] kak[o|u]</PHON>
        <TRANSL xml:lang="zho">我的肚腹漲氣</TRANSL>
    </S>
    <S id="S-L04198-e01">
        <FORM kindOf="original" notes="printed p.135 l.31–p.135 l.32">maforaw a komaen</FORM>
        <FORM kindOf="standard">mavuraw a kumaen</FORM>
        <PHON kindOf="standard">ma[b|v][o|u]raw a k[o|u]maən</PHON>
        <TRANSL xml:lang="zho">吃快，貪食的</TRANSL>
    </S>
    <S id="S-L04312-e01">
        <FORM kindOf="original" notes="printed p.139 l.13–p.139 l.14">mafso ko tiyad nira saka powaxan cigra</FORM>
        <FORM kindOf="standard">mavsu ku tiyad nira saka puwaxan cingra</FORM>
        <PHON kindOf="standard">ma[b|v]s[o|u] k[o|u] tijad nira saka p[o|u]waxan ʦiŋra</PHON>
        <TRANSL xml:lang="zho">他的肚皮腫漲到要破裂</TRANSL>
    </S>
    <S id="S-L04399-e01">
        <FORM kindOf="original" notes="printed p.143 l.08">gaget kiso</FORM>
        <FORM kindOf="standard">nganget kisu</FORM>
        <PHON kindOf="standard">ŋaŋət kis[o|u]</PHON>
        <TRANSL xml:lang="zho">你算什麼，不理人家</TRANSL>
    </S>
    <S id="S-L04907-e01">
        <FORM kindOf="original" notes="printed p.160 l.17">mahanac ko tama'</FORM>
        <FORM kindOf="standard">mahanac ku tama'</FORM>
        <PHON kindOf="standard">maħanaʦ k[o|u] tamaʡ</PHON>
        <TRANSL xml:lang="zho">沒有捕到什麼</TRANSL>
    </S>
    <S id="S-L04917-e01">
        <FORM kindOf="original" notes="printed p.160 l.30–p.160 l.31; printed in parentheses: (haneknek)">haneklek saan cigra a maro'to roray a matayal</FORM>
        <FORM kindOf="standard">haneklek saan cingra a maru'tu ruray a matayal</FORM>
        <PHON kindOf="standard">ħanəkɾək saan ʦiŋra a mar[o|u]ʡt[o|u] r[o|u]raj a matajaɾ</PHON>
        <TRANSL xml:lang="zho">因工作的勞累，他一坐下就不動</TRANSL>
    </S>
    <S id="S-L05249-e01">
        <FORM kindOf="original" notes="printed p.171 l.21">hkad no 'a'adopen</FORM>
        <FORM kindOf="standard">hkad nu 'a'adupen</FORM>
        <PHON kindOf="standard">ħkad n[o|u] ʡaʡad[o|u]pən</PHON>
        <TRANSL xml:lang="zho">獵物的足跡</TRANSL>
    </S>
    <S id="S-L05395-e01">
        <FORM kindOf="original" notes="printed p.175 l.38–p.175 l.39">horihoran no wawa ko nemnem a migota</FORM>
        <FORM kindOf="standard">hurihuran nu wawa ku nemnem a minguta</FORM>
        <PHON kindOf="standard">ħ[o|u]riħ[o|u]ran n[o|u] wawa k[o|u] nəmnəm a miŋ[o|u]ta</PHON>
        <TRANSL xml:lang="zho">水泉給小孩腳踏踏而弄髒</TRANSL>
    </S>
    <S id="S-L05450-e01">
        <FORM kindOf="original" notes="printed p.177 l.26–p.177 l.27">htofen ko caag nora liwkag a miala to hci</FORM>
        <FORM kindOf="standard">htuven ku caang nura liwkang a miala tu hci</FORM>
        <PHON kindOf="standard">ħt[o|u][b|v]ən k[o|u] ʦaaŋ n[o|u]ra ɾiwkaŋ a miaɾa t[o|u] ħʦi</PHON>
        <TRANSL xml:lang="zho">把龍眼樹的枝拉彎，好拿它的果實</TRANSL>
    </S>
    <S id="S-L05494-e01">
        <FORM kindOf="original" notes="printed p.179 l.22–p.179 l.23">ka awaay ko ga'ayay</FORM>
        <FORM kindOf="standard">ka awaay ku nga'ayay</FORM>
        <PHON kindOf="standard">ka awaaj k[o|u] ŋaʡajaj</PHON>
        <TRANSL xml:lang="zho">總比沒有的好</TRANSL>
    </S>
    <S id="S-L05494-e02-1">
        <FORM kindOf="original" notes="printed p.179 l.22–p.179 l.23; no translation in the source; alternative 1 of 2 in the source: idahi ho = ka awa to kira！">idahi ho</FORM>
        <FORM kindOf="standard">idahi hu</FORM>
        <PHON kindOf="standard">idaħi ħ[o|u]</PHON>
    </S>
    <S id="S-L05494-e02-2">
        <FORM kindOf="original" notes="printed p.179 l.22–p.179 l.23; no translation in the source; alternative 2 of 2 in the source: idahi ho = ka awa to kira！">ka awa to kira!</FORM>
        <FORM kindOf="standard">ka awa tu kira!</FORM>
        <PHON kindOf="standard">ka awa t[o|u] kira</PHON>
    </S>
    <S id="S-L06042-e01">
        <FORM kindOf="original" notes="printed p.196 l.26–p.196 l.27; source: 詩 148,4">"Kafkagay a nanom"</FORM>
        <FORM kindOf="standard">"Kavkangay a nanum"</FORM>
        <PHON kindOf="standard">ka[b|v]kaŋaj a nan[o|u]m</PHON>
        <TRANSL xml:lang="zho">＂天上的眾水＂</TRANSL>
    </S>
    <S id="S-L06099-e01">
        <FORM kindOf="original" notes="printed p.198 l.16–p.198 l.18; source: 詩 64,9">"O nanom nonini a'alo ko sakararid no sra, a ci kinayra to to kahirahira no pinaloma"</FORM>
        <FORM kindOf="standard">"U nanum nunini a'alu ku sakararid nu sra, a ci kinayra tu tu kahirahira nu pinaluma"</FORM>
        <PHON kindOf="standard">[o|u] nan[o|u]m n[o|u]nini aʡaɾ[o|u] k[o|u] sakararid n[o|u] sra a ʦi kinajra t[o|u] t[o|u] kaħiraħira n[o|u] pinaɾ[o|u]ma</PHON>
        <TRANSL xml:lang="zho">＂你看顧大地降霖霖雨滋潤它，你是大地肥沃豐收＂</TRANSL>
    </S>
    <S id="S-L06212-e01">
        <FORM kindOf="original" notes="printed p.201 l.31–p.201 l.32">malotay ko kakawig nira</FORM>
        <FORM kindOf="standard">malutay ku kakawing nira</FORM>
        <PHON kindOf="standard">maɾ[o|u]taj k[o|u] kakawiŋ nira</PHON>
        <TRANSL xml:lang="zho">他的動作很煖</TRANSL>
    </S>
    <S id="S-L06396-e01">
        <FORM kindOf="original" notes="printed p.207 l.26–p.207 l.27">kaliki cigra a mipahrek to tayal</FORM>
        <FORM kindOf="standard">kaliki cingra a mipahrek tu tayal</FORM>
        <PHON kindOf="standard">kaɾiki ʦiŋra a mipaħrək t[o|u] tajaɾ</PHON>
        <TRANSL xml:lang="zho">他很快地把工作完成了</TRANSL>
    </S>
    <S id="S-L06547-e01">
        <FORM kindOf="original" notes="printed p.212 l.24–p.212 l.26">ano matiyatiyaay ko kacacoli' namo icila, kananokay ito ko faloco' namo</FORM>
        <FORM kindOf="standard">anu matiyatiyaay ku kacaculi' namu icila, kananukay itu ku valucu' namu</FORM>
        <PHON kindOf="standard">an[o|u] matijatijaaj k[o|u] kaʦaʦ[o|u]ɾiʡ nam[o|u] iʦiɾa kanan[o|u]kaj it[o|u] k[o|u] [b|v]aɾ[o|u]ʦ[o|u]ʡ nam[o|u]</PHON>
        <TRANSL xml:lang="zho">前幾天你們雖然吵架，心還是要回頭和好</TRANSL>
    </S>
    <S id="S-L06952-e01">
        <FORM kindOf="original" notes="printed p.225 l.09–p.225 l.10">ccay kawat nira lima awas ako</FORM>
        <FORM kindOf="standard">ccay kawat nira lima awas aku</FORM>
        <PHON kindOf="standard">ʦʦaj kawat nira ɾima awas ak[o|u]</PHON>
        <TRANSL xml:lang="zho">他一小步寬於我的五大步</TRANSL>
    </S>
    <S id="S-L06980-e01">
        <FORM kindOf="original" notes="printed p.226 l.07; printed in parentheses: (sa)">pa kamayan</FORM>
        <FORM kindOf="standard">pa kamayan</FORM>
        <PHON kindOf="standard">pa kamajan</PHON>
        <TRANSL xml:lang="zho">手套</TRANSL>
    </S>
    <S id="S-L07623-e01">
        <FORM kindOf="original" notes="printed p.246 l.09–p.246 l.10">kolapen a mifalah ko pakatogroh a lali'</FORM>
        <FORM kindOf="standard">kulapen a mivalah ku pakatungruh a lali'</FORM>
        <PHON kindOf="standard">k[o|u]ɾapən a mi[b|v]aɾaħ k[o|u] pakat[o|u]ŋr[o|u]ħ a ɾaɾiʡ</PHON>
        <TRANSL xml:lang="zho">砂子最上層含有土的部份鏟除掉</TRANSL>
    </S>
    <S id="S-L07819-e02">
        <FORM kindOf="original" notes="printed p.252 l.18–p.252 l.20">ko'san no 'odal</FORM>
        <FORM kindOf="original" ver="alt">ko'san no 'odaz</FORM>
        <FORM kindOf="standard">ku'san nu 'udal</FORM>
        <PHON kindOf="standard">k[o|u]ʡsan n[o|u] ʡ[o|u]daɾ</PHON>
        <FORM kindOf="standard" ver="alt">ku'san nu 'udaz</FORM>
        <TRANSL xml:lang="zho">恭維話</TRANSL>
    </S>
    <S id="S-L08203-e01">
        <FORM kindOf="original" notes="printed p.265 l.25">o icoaay ko lahodayay saw?</FORM>
        <FORM kindOf="standard">u icuaay ku lahudayay saw?</FORM>
        <PHON kindOf="standard">[o|u] iʦ[o|u]aaj k[o|u] ɾaħ[o|u]dajaj saw</PHON>
        <TRANSL xml:lang="zho">那一個是容易的？</TRANSL>
    </S>
    <S id="S-L08228-e01">
        <FORM kindOf="original" notes="printed p.266 l.20">radiw ko lakagaw</FORM>
        <FORM kindOf="standard">radiw ku lakangaw</FORM>
        <PHON kindOf="standard">radiw k[o|u] ɾakaŋaw</PHON>
        <TRANSL xml:lang="zho">老女人隼團的歌唱</TRANSL>
    </S>
    <S id="S-L08296-e01">
        <FORM kindOf="original" notes="printed p.268 l.32–p.268 l.33">anini ko lalat ita a caay to ka rara'od</FORM>
        <FORM kindOf="standard">anini ku lalat ita a caay tu ka rara'ud</FORM>
        <PHON kindOf="standard">anini k[o|u] ɾaɾat ita a ʦaaj t[o|u] ka raraʡ[o|u]d</PHON>
        <TRANSL xml:lang="zho">我們從此以後不再往來</TRANSL>
    </S>
    <S id="S-L08314-e01">
        <FORM kindOf="original" notes="printed p.269 l.19">o lalgatan nira to sakafiragaw</FORM>
        <FORM kindOf="standard">u lalngatan nira tu sakavirangaw</FORM>
        <PHON kindOf="standard">[o|u] ɾaɾŋatan nira t[o|u] saka[b|v]iraŋaw</PHON>
        <TRANSL xml:lang="zho">他要罵人的藉口</TRANSL>
    </S>
    <S id="S-L08357-e01">
        <FORM kindOf="original" notes="printed p.270 l.29–p.270 l.30">saliyaliyad saan ko nipifiyok no tata'agay a fali</FORM>
        <FORM kindOf="standard">saliyaliyad saan ku nipiviyuk nu tata'angay a vali</FORM>
        <PHON kindOf="standard">saɾijaɾijad saan k[o|u] nipi[b|v]ij[o|u]k n[o|u] tataʡaŋaj a [b|v]aɾi</PHON>
        <TRANSL xml:lang="zho">強風一陣一陣地吹來</TRANSL>
    </S>
    <S id="S-L08555-e01">
        <FORM kindOf="original" notes="printed p.277 l.17">mala'toay a tamdaw</FORM>
        <FORM kindOf="standard">mala'tuay a tamdaw</FORM>
        <PHON kindOf="standard">maɾaʡt[o|u]aj a tamdaw</PHON>
        <TRANSL xml:lang="zho">很兇的人</TRANSL>
    </S>
    <S id="S-L08663-e01">
        <FORM kindOf="original" notes="printed p.281 l.09–p.281 l.10">adihay ko 'lem nona rara' no naniwac</FORM>
        <FORM kindOf="standard">adihay ku 'lem nuna rara' nu naniwac</FORM>
        <PHON kindOf="standard">adiħaj k[o|u] ʡɾəm n[o|u]na raraʡ n[o|u] naniwaʦ</PHON>
        <TRANSL xml:lang="zho">這綠豆湯很多煮不爛的了</TRANSL>
    </S>
    <S id="S-L08691-e01">
        <FORM kindOf="original" notes="printed p.281 l.42–p.282 l.07">o pipalfodan to tayal anini, awaay ko limaw a misalama</FORM>
        <FORM kindOf="standard">u pipalvudan tu tayal anini, awaay ku limaw a misalama</FORM>
        <PHON kindOf="standard">[o|u] pipaɾ[b|v][o|u]dan t[o|u] tajaɾ anini awaaj k[o|u] ɾimaw a misaɾama</PHON>
        <TRANSL xml:lang="zho">現在是農忙時期，沒空去玩</TRANSL>
    </S>
    <S id="S-L08702-e01">
        <FORM kindOf="original" notes="printed p.282 l.21">dogec no lgac</FORM>
        <FORM kindOf="standard">dungec nu lngac</FORM>
        <PHON kindOf="standard">d[o|u]ŋəʦ n[o|u] ɾŋaʦ</PHON>
        <TRANSL xml:lang="zho">月桃心</TRANSL>
    </S>
    <S id="S-L09178-e01">
        <FORM kindOf="original" notes="printed p.297 l.16–p.297 l.17; source: 申 26,5">"O miliwadiway a tamdaw no Aram ko gasaw nira"</FORM>
        <FORM kindOf="standard">"U miliwadiway a tamdaw nu Aram ku ngasaw nira"</FORM>
        <PHON kindOf="standard">[o|u] miɾiwadiwaj a tamdaw n[o|u] aram k[o|u] ŋasaw nira</PHON>
        <TRANSL xml:lang="zho">＂我的祖先是"亞蘭"人＂</TRANSL>
    </S>
    <S id="S-L09311-e01">
        <FORM kindOf="original" notes="printed p.301 l.34–p.301 l.35">"Loditen ni Yiso to sna' ko mata ako"</FORM>
        <FORM kindOf="standard">"Luditen ni Yisu tu sna' ku mata aku"</FORM>
        <PHON kindOf="standard">ɾ[o|u]ditən ni jis[o|u] t[o|u] snaʡ k[o|u] mata ak[o|u]</PHON>
        <TRANSL xml:lang="zho">＂耶穌用了泥漿磨擦我的眼睛＂</TRANSL>
    </S>
    <S id="S-L09411-e01">
