<TEXT id="poinsot_chinese_T_examples" citation="Cuerq, G. (顧向前, Ci Ka Ogto), &amp; Pourrias, L. (博利亞) (2002). O Citig no Amis: 阿美語－漢語字典. French translations for pages 1-4: Poinsot, M., &amp; Pourrias, L. (n.d.). Amis-French dictionary. Missions Etrangères de Paris." BibTeX_citation="@book{cuerq_pourrias_2002, author={Cuerq, G{\'e}rard and Pourrias, Louis}, title={O Citig no Amis: 阿美語－漢語字典}, year={2002}, note={Compiler 顧向前 (Ci Ka Ogto); Amis text revised by 博利亞 Louis Pourrias. French translations for pages 1-4 from Poinsot, Maurice and Pourrias, Louis, Amis-French dictionary, n.d.}}" copyright="CC BY-NC 4.0" xml:lang="ami" source="wildjcrt/amis-chinese-poinsot-onefile@365cfceca84c0edbb6af08133ce4e05e5c5291c0 pourrias-poinsot.txt; printed page/line from miaoski/amis-chinese-poinsot@a35e2cbfd48002e15ddca87f674045c0376ed2cc toufu.sq3; source label T" glottocode="amis1246" dialect="Xiuguluan">
    <S id="T-L01352-e01">
        <FORM kindOf="original" notes="printed p.045 l.39">caniwciw ko tiyad</FORM>
        <FORM kindOf="standard">caniwciw ko tiyad</FORM>
        <PHON kindOf="standard">ʦaniwʦiw k[o|u] tija[ɬ|ɮ]</PHON>
        <TRANSL xml:lang="zho">肚子餓時會叫</TRANSL>
    </S>
    <S id="T-L04551-e01">
        <FORM kindOf="original" notes="printed p.148 l.06">magilay ko sowal</FORM>
        <FORM kindOf="standard">mangilay ko sowal</FORM>
        <PHON kindOf="standard">maŋiɾaj k[o|u] s[o|u]waɾ</PHON>
        <TRANSL xml:lang="zho">不太清楚地講話</TRANSL>
    </S>
    <S id="T-L04756-e01">
        <FORM kindOf="original" notes="printed p.155 l.15–p.155 l.16">hafidot han nira ko panay a comikay</FORM>
        <FORM kindOf="standard">hafidot han nira ko panay a comikay</FORM>
        <PHON kindOf="standard">ħafi[ɬ|ɮ][o|u]t ħan nira k[o|u] panaj a ʦ[o|u]mikaj</PHON>
        <TRANSL xml:lang="zho">他很粗野的從稻田跑過去</TRANSL>
    </S>
    <S id="T-L05123-e01">
        <FORM kindOf="original" notes="printed p.167 l.31–p.167 l.32">mahidacay a maasik</FORM>
        <FORM kindOf="standard">mahidacay a maasik</FORM>
        <PHON kindOf="standard">maħi[ɬ|ɮ]aʦaj a maasik</PHON>
        <TRANSL xml:lang="zho">掃的乾淨</TRANSL>
    </S>
    <S id="T-L05123-e02">
        <FORM kindOf="original" notes="printed p.167 l.31–p.167 l.32">yo miridas to diwac</FORM>
        <FORM kindOf="standard">yo miridas to diwac</FORM>
        <PHON kindOf="standard">j[o|u] miri[ɬ|ɮ]as t[o|u] [ɬ|ɮ]iwaʦ</PHON>
        <TRANSL xml:lang="zho">使洗淨聖爵</TRANSL>
    </S>
    <S id="T-L06001-e01">
        <FORM kindOf="original" notes="printed p.195 l.21; no translation in the source">o maan ko nipakaenan iso?</FORM>
        <FORM kindOf="standard">o maan ko nipakaenan iso?</FORM>
        <PHON kindOf="standard">[o|u] maan k[o|u] nipakaənan is[o|u]</PHON>
    </S>
    <S id="T-L06171-e01">
        <FORM kindOf="original" notes="printed p.200 l.22–p.200 l.23">kaka kafikafit no pcas no parod</FORM>
        <FORM kindOf="standard">kaka kafikafit no pcas no parod</FORM>
        <PHON kindOf="standard">kaka kafikafit n[o|u] pʦas n[o|u] par[o|u][ɬ|ɮ]</PHON>
        <TRANSL xml:lang="zho">各地親屬的連結關係</TRANSL>
    </S>
    <S id="T-L06333-e01">
        <FORM kindOf="original" notes="printed p.205 l.21–p.205 l.23">adada ko tiyad to pitatawaan a mitgil to pisakomot nona tamdaw</FORM>
        <FORM kindOf="standard">adada ko tiyad to pitatawaan a mitngil to pisakomot nona tamdaw</FORM>
        <PHON kindOf="standard">a[ɬ|ɮ]a[ɬ|ɮ]a k[o|u] tija[ɬ|ɮ] t[o|u] pitatawaan a mitŋiɾ t[o|u] pisak[o|u]m[o|u]t n[o|u]na tam[ɬ|ɮ]aw</PHON>
        <TRANSL xml:lang="zho">聽了這個人的笑話，笑到肚皮都痛了</TRANSL>
    </S>
    <S id="T-L06798-e01">
        <FORM kindOf="original" notes="printed p.220 l.18–p.220 l.19">kasafaled ho no niyaro' ko nira a paloma'an</FORM>
        <FORM kindOf="standard">kasafaled ho no niyaro' ko nira a paloma'an</FORM>
        <PHON kindOf="standard">kasafaɾə[ɬ|ɮ] ħ[o|u] n[o|u] nijar[o|u]ʡ k[o|u] nira a paɾ[o|u]maʡan</PHON>
        <TRANSL xml:lang="zho">他的家在村莊的上一層</TRANSL>
    </S>
    <S id="T-L09365-e01">
        <FORM kindOf="original" notes="printed p.303 l.24">loh no tireg</FORM>
        <FORM kindOf="standard">loh no tireng</FORM>
        <PHON kindOf="standard">ɾ[o|u]ħ n[o|u] tirəŋ</PHON>
        <TRANSL xml:lang="zho">身體的臭味，體臭，污垢在衣服上</TRANSL>
    </S>
    <S id="T-L10155-e01">
        <FORM kindOf="original" notes="printed p.329 l.20–p.329 l.21">masano lnay a masatafowas ko ca'ag no kilag</FORM>
        <FORM kindOf="standard">masano lnay a masatafowas ko ca'ang no kilang</FORM>
        <PHON kindOf="standard">masan[o|u] ɾnaj a masataf[o|u]was k[o|u] ʦaʡaŋ n[o|u] kiɾaŋ</PHON>
        <TRANSL xml:lang="zho">枝葉茂密形如陽傘</TRANSL>
    </S>
    <S id="T-L10437-e01">
        <FORM kindOf="original" notes="printed p.338 l.26–p.338 l.27">misakakinih ko faloco' nira to padek a wawa</FORM>
        <FORM kindOf="standard">misakakinih ko faloco' nira to padek a wawa</FORM>
        <PHON kindOf="standard">misakakiniħ k[o|u] faɾ[o|u]ʦ[o|u]ʡ nira t[o|u] pa[ɬ|ɮ]ək a wawa</PHON>
        <TRANSL xml:lang="zho">他對養子偏心</TRANSL>
    </S>
    <S id="T-L10824-e01">
        <FORM kindOf="original" notes="printed p.351 l.15–p.351 l.16">nafay sa o</FORM>
        <FORM kindOf="standard">nafay sa o</FORM>
        <PHON kindOf="standard">nafaj sa [o|u]</PHON>
        <TRANSL xml:lang="zho">憐憫的驚呼</TRANSL>
    </S>
    <S id="T-L10824-e02">
        <FORM kindOf="original" notes="printed p.351 l.15–p.351 l.16">nafay kona wawa i'</FORM>
        <FORM kindOf="standard">nafay kona wawa i'</FORM>
        <PHON kindOf="standard">nafaj k[o|u]na wawa iʡ</PHON>
        <TRANSL xml:lang="zho">有沒有看得到那樣的孩子！</TRANSL>
    </S>
    <S id="T-L12232-e01">
        <FORM kindOf="original" notes="printed p.400 l.12">mipa'pod to saparod</FORM>
        <FORM kindOf="standard">mipa'pod to saparod</FORM>
        <PHON kindOf="standard">mipaʡp[o|u][ɬ|ɮ] t[o|u] sapar[o|u][ɬ|ɮ]</PHON>
        <TRANSL xml:lang="zho">卸任，分開繼承</TRANSL>
    </S>
    <S id="T-L13312-e01">
        <FORM kindOf="original" notes="printed p.437 l.17–p.437 l.18; source: 路 16,24">"Maragrag kako i lamal"</FORM>
        <FORM kindOf="standard">"Marangrang kako i lamal"</FORM>
        <PHON kindOf="standard">maraŋraŋ kak[o|u] i ɾamaɾ</PHON>
        <TRANSL xml:lang="zho">＂我在這火燄裡，非常痛苦＂</TRANSL>
    </S>
    <S id="T-L13708-e01">
        <FORM kindOf="original" notes="printed p.451 l.32–p.451 l.33">palsirinien kora tatosaay a wawa</FORM>
        <FORM kindOf="standard">palsirinien kora tatosaay a wawa</FORM>
        <PHON kindOf="standard">paɾsiriniən k[o|u]ra tat[o|u]saaj a wawa</PHON>
        <TRANSL xml:lang="zho">和位小孩子比較看看</TRANSL>
    </S>
    <S id="T-L13736-e01">
        <FORM kindOf="original" notes="printed p.452 l.26–p.452 l.27">marorih kona wawa to ka adadaan nira</FORM>
        <FORM kindOf="standard">marorih kona wawa to ka adadaan nira</FORM>
        <PHON kindOf="standard">mar[o|u]riħ k[o|u]na wawa t[o|u] ka a[ɬ|ɮ]a[ɬ|ɮ]aan nira</PHON>
        <TRANSL xml:lang="zho">小孩因為生重病，故身體瘦的像皮包骨一樣</TRANSL>
    </S>
    <S id="T-L13872-e01">
        <FORM kindOf="original" notes="printed p.457 l.16–p.457 l.19">marokrok ko nanom</FORM>
        <FORM kindOf="standard">marokrok ko nanom</FORM>
        <PHON kindOf="standard">mar[o|u]kr[o|u]k k[o|u] nan[o|u]m</PHON>
        <TRANSL xml:lang="zho">水已滾開了</TRANSL>
    </S>
    <S id="T-L13872-e02">
        <FORM kindOf="original" notes="printed p.457 l.16–p.457 l.19">marokrok ko faloco' ako</FORM>
        <FORM kindOf="standard">marokrok ko faloco' ako</FORM>
        <PHON kindOf="standard">mar[o|u]kr[o|u]k k[o|u] faɾ[o|u]ʦ[o|u]ʡ ak[o|u]</PHON>
        <TRANSL xml:lang="zho">我心裡很怒氣</TRANSL>
    </S>
    <S id="T-L13872-e03">
        <FORM kindOf="original" notes="printed p.457 l.16–p.457 l.19; source: 詩 68,10">"Rokrok sa ko faloco' ako a malalok to saki pita'ogan tisowanan a loma'"</FORM>
        <FORM kindOf="standard">"Rokrok sa ko faloco' ako a malalok to saki pita'ongan tisowanan a loma'"</FORM>
        <PHON kindOf="standard">r[o|u]kr[o|u]k sa k[o|u] faɾ[o|u]ʦ[o|u]ʡ ak[o|u] a maɾaɾ[o|u]k t[o|u] saki pitaʡ[o|u]ŋan tis[o|u]wanan a ɾ[o|u]maʡ</PHON>
        <TRANSL xml:lang="zho">＂我對你聖殿大發熱心＂</TRANSL>
    </S>
    <S id="T-L14050-e01">
        <FORM kindOf="original" notes="printed p.464 l.09">misadoa ko fali</FORM>
        <FORM kindOf="standard">misadoa ko fali</FORM>
        <PHON kindOf="standard">misa[ɬ|ɮ][o|u]a k[o|u] faɾi</PHON>
        <TRANSL xml:lang="zho">風停止了</TRANSL>
    </S>
    <S id="T-L16073-e01">
        <FORM kindOf="original" notes="printed p.533 l.33–p.533 l.34">tahorirac ko waay nira, talinag saan a mapolin</FORM>
        <FORM kindOf="standard">tahorirac ko waay nira, talinang saan a mapolin</FORM>
        <PHON kindOf="standard">taħ[o|u]riraʦ k[o|u] waaj nira taɾinaŋ saan a map[o|u]ɾin</PHON>
        <TRANSL xml:lang="zho">他腳滑向後，仰翻倒了</TRANSL>
    </S>
    <S id="T-L16400-e01">
        <FORM kindOf="original" notes="printed p.545 l.14–p.545 l.17">ta'sel ko pinegneg no Kawas</FORM>
        <FORM kindOf="standard">ta'sel ko pinengneng no Kawas</FORM>
        <PHON kindOf="standard">taʡsəɾ k[o|u] pinəŋnəŋ n[o|u] kawas</PHON>
        <TRANSL xml:lang="zho">上主能看得見內心</TRANSL>
    </S>
    <S id="T-L16400-e02">
        <FORM kindOf="original" notes="printed p.545 l.14–p.545 l.17; source: 林前 2,10">"Mata'sel no Seilei ko polog"</FORM>
        <FORM kindOf="standard">"Mata'sel no Seilei ko polong"</FORM>
        <PHON kindOf="standard">mataʡsəɾ n[o|u] səiɾəi k[o|u] p[o|u]ɾ[o|u]ŋ</PHON>
        <TRANSL xml:lang="zho">＂聖神細察萬事＂</TRANSL>
    </S>
    <S id="T-L16400-e03">
        <FORM kindOf="original" notes="printed p.545 l.14–p.545 l.17">mita'sel ko rinom nira to kiftolay a rafir</FORM>
        <FORM kindOf="standard">mita'sel ko rinom nira to kiftolay a rafir</FORM>
        <PHON kindOf="standard">mitaʡsəɾ k[o|u] rin[o|u]m nira t[o|u] kift[o|u]ɾaj a rafir</PHON>
        <TRANSL xml:lang="zho">他的針能剌透厚的皮</TRANSL>
    </S>
    <S id="T-L16949-e01">
        <FORM kindOf="original" notes="printed p.563 l.26">satisoctisoc sa</FORM>
        <FORM kindOf="standard">satisoctisoc sa</FORM>
        <PHON kindOf="standard">satis[o|u]ʦtis[o|u]ʦ sa</PHON>
        <TRANSL xml:lang="zho">參差不正</TRANSL>
    </S>
    <S id="T-L17397-e01">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">masaporoporog ko to'man</FORM>
        <FORM kindOf="standard">masaporoporong ko to'man</FORM>
        <PHON kindOf="standard">masap[o|u]r[o|u]p[o|u]r[o|u]ŋ k[o|u] t[o|u]ʡman</PHON>
        <TRANSL xml:lang="zho">深夜</TRANSL>
    </S>
    <S id="T-L17397-e02">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">to'man ko kakarayan</FORM>
        <FORM kindOf="standard">to'man ko kakarayan</FORM>
        <PHON kindOf="standard">t[o|u]ʡman k[o|u] kakarajan</PHON>
        <TRANSL xml:lang="zho">天陰暗了</TRANSL>
    </S>
    <S id="T-L17397-e03-1">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14; alternative 1 of 2 in the source: to’man to ko tomi’ad = o dadaya to">to'man to ko tomi'ad</FORM>
        <FORM kindOf="standard">to'man to ko tomi'ad</FORM>
        <PHON kindOf="standard">t[o|u]ʡman t[o|u] k[o|u] t[o|u]miʡa[ɬ|ɮ]</PHON>
        <TRANSL xml:lang="zho">天已變了黑</TRANSL>
    </S>
    <S id="T-L17397-e03-2">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14; alternative 2 of 2 in the source: to’man to ko tomi’ad = o dadaya to">o dadaya to</FORM>
        <FORM kindOf="standard">o dadaya to</FORM>
        <PHON kindOf="standard">[o|u] [ɬ|ɮ]a[ɬ|ɮ]aja t[o|u]</PHON>
        <TRANSL xml:lang="zho">天已變了黑</TRANSL>
    </S>
    <S id="T-L17397-e04">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">sa to'man saan</FORM>
        <FORM kindOf="standard">sa to'man saan</FORM>
        <PHON kindOf="standard">sa t[o|u]ʡman saan</PHON>
        <TRANSL xml:lang="zho">天黑了</TRANSL>
    </S>
    <S id="T-L17397-e05">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">sa to'man saan</FORM>
        <FORM kindOf="standard">sa to'man saan</FORM>
        <PHON kindOf="standard">sa t[o|u]ʡman saan</PHON>
        <TRANSL xml:lang="zho">傍晚</TRANSL>
    </S>
    <S id="T-L17397-e06">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">i mahka to'man</FORM>
        <FORM kindOf="standard">i mahka to'man</FORM>
        <PHON kindOf="standard">i maħka t[o|u]ʡman</PHON>
        <TRANSL xml:lang="zho">傍晚時</TRANSL>
    </S>
    <S id="T-L17397-e07">
        <FORM kindOf="original" notes="printed p.579 l.11–p.579 l.14">to'man ko pisig nira</FORM>
        <FORM kindOf="standard">to'man ko pising nira</FORM>
        <PHON kindOf="standard">t[o|u]ʡman k[o|u] pisiŋ nira</PHON>
        <TRANSL xml:lang="zho">他的臉上顯示不悅的樣子</TRANSL>
    </S>
</TEXT>