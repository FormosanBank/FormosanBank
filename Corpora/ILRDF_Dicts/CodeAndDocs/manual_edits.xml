    <FILE path="Saaroa/Saaroa.xml">
        <S id="Saaroa_3823120a-f70a-f011-bd65-00155db40116">
            <FORM kindOf="original">apuaʉnʉmʉ cucuana ʼasaruna.</FORM>
            <TRANSL xml:lang="zho">把雞蛋分成六個人份。</TRANSL>
        </S>
        <S id="Saaroa_6c27120a-f70a-f011-bd65-00155db40116">
            <FORM kindOf="original">hlaʼalua maci kapitanʉia ihlaisa macahlia malialualu.</FORM>
            <TRANSL xml:lang="zho">hla'alua說kapitanu是領導者。</TRANSL>
        </S>
        <S id="Saaroa_9827120a-f70a-f011-bd65-00155db40116">
            <FORM kindOf="original">kukicumia tʉnʉmʉa saliaisa hlakanaʼana.</FORM>
            <TRANSL xml:lang="zho">他們的家不是靠海邊的。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/8e7c9968-7212-4adb-9607-24cc3bbf80f2/download" file="Saaroa_9827120a-f70a-f011-bd65-00155db40116.mp3"/>
        </S>
        <S id="Saaroa_8a2e120a-f70a-f011-bd65-00155db40116">
            <FORM kindOf="original">marua aʉnʉmʉ tapuhlacungu mucukuhlu tapikakua miararuma.</FORM>
            <TRANSL xml:lang="zho">有六隻猴子跑到村子裏面來了。</TRANSL>
        </S>
        <S id="Saaroa_0b29120a-f70a-f011-bd65-00155db40116">
            <FORM kindOf="original">ʉnʉmʉ paapuhla ualuia laihla upatu.</FORM>
            <TRANSL xml:lang="zho">六加八是十四。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/f91aa675-3c2f-44ca-88f4-ebc180a57c5b/download" file="Saaroa_0b29120a-f70a-f011-bd65-00155db40116.mp3"/>
        </S>
    </FILE>
    <FILE path="Thao/Thao.xml">
        <S id="Thao_257e7f58-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">finlhuqiza ihu buut? ua! finlhuqiza iaku, finlhuqiza mani ihu?</FORM>
            <TRANSL xml:lang="zho">已經洗好澡了嗎？是的！我已經洗好了。你也洗好了嗎？</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/e2dab22f-6862-436b-af74-cd708274e19a/download" file="Thao_257e7f58-e70a-f011-bd65-00155db40116.mp3"/>
        </S>
        <S id="Thao_69ee8e4c-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">haya wa pruq maqa sa Thau a tinulhanaz zain Sulikhiin, numa sa Shpuut muntal mzai</FORM>
            <TRANSL xml:lang="zho">這地方因為是邵族起名子(命名)被叫做Sulikhiin，漢人也跟著稱之為水裏坑。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/dd79816d-45cb-4f1e-b20e-2fdaefe1173f/download" file="Thao_69ee8e4c-e70a-f011-bd65-00155db40116.mp3"/>
        </S>
        <S id="Thao_403b8752-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">inanuru! aʼishwuaqan.</FORM>
            <TRANSL xml:lang="zho">要注意！會燙到。</TRANSL>
        </S>
        <S id="Thao_cf787f58-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">mataqaz yaku sa pazay.</FORM>
            <TRANSL xml:lang="zho">正挑稻穀要回家曬。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/6cf98069-b89c-4975-aa0e-eebb4cc37333/download" file="Thao_cf787f58-e70a-f011-bd65-00155db40116.mp3"/>
        </S>
        <S id="Thao_333b8752-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">palanhaha ita! iatunaw makaruza!</FORM>
            <TRANSL xml:lang="zho">我們衝！用力划！</TRANSL>
        </S>
        <S id="Thao_30797f58-e70a-f011-bd65-00155db40116">
            <FORM kindOf="original">uka mihu a patatash, haya naak a patatash arahu( ara uhu) matash.</FORM>
            <TRANSL xml:lang="zho">沒有筆，我的筆你拿去寫。－arahu為ara uhu的簡省。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/c82e161f-4818-4117-96a7-c8158704b115/download" file="Thao_30797f58-e70a-f011-bd65-00155db40116.mp3"/>
        </S>
    </FILE>
