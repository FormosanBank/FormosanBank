    <FILE path="Puyuma/Puyuma.xml">
        <S id="Puyuma_4379e175-8b33-f011-8fad-000d3a8250a0">
            <FORM kindOf="original">adawilr na puatraiyan. ulraya kandriyu na kawi i saninin.</FORM>
            <TRANSL xml:lang="zho">廁所很遠，在那棵樹的旁邊。</TRANSL>
            <AUDIO url="https://sys-dictionary.ilrdf.org.tw/Data/api/Storage/fe3f5415-c255-48e9-8524-c61037634b92/download" file="Puyuma_4379e175-8b33-f011-8fad-000d3a8250a0.mp3"/>
