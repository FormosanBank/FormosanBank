{"page": 3, "rows": [{"x": 116, "y": 128, "w": 74, "h": 10, "text": "臺灣南島語言叢書"}, {"x": 113, "y": 150, "w": 93, "h": 20, "text": "卡那卡那富語"}, {"x": 113, "y": 174, "w": 93, "h": 19, "text": "語法概論"}, {"x": 194, "y": 130, "w": 7, "h": 7, "text": "16"}]}
