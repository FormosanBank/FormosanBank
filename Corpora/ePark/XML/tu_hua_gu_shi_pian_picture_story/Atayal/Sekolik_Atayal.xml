<TEXT id="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal" xml:lang="tay" source="圖畫故事篇 Sekolik_Atayal" audio="diarized" copyright="CC-BY-NC-SA" citation="Indigenous Languages Research and Development Foundation. (2020). 族語E樂園. https://web.klokah.tw/" BibTeX_citation="@misc{ePark, author = {Indigenous Languages Research and Development Foundation}, title = {族語E樂園}, year = {2020}, url = {https://web.klokah.tw/} }" glottocode="" dialect="Sekolik">
    <S id="229621">
        <FORM kindOf="original">nanu qani?</FORM>
        <FORM kindOf="standard">nanu qani?</FORM>
        <PHON kindOf="standard">nanu qani</PHON>
        <TRANSL xml:lang="zho">這是什麼?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229621.wav" url="https://web.klokah.tw/text/sound/17607/229621.mp3" start="0" end="1.91" />
    </S>
    <S id="229622">
        <FORM kindOf="original">qani ga lukus.</FORM>
        <FORM kindOf="standard">qani ga lukus.</FORM>
        <PHON kindOf="standard">qani ɣa luku[s|ɕ]</PHON>
        <TRANSL xml:lang="zho">這是衣服。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229622.wav" url="https://web.klokah.tw/text/sound/17607/229622.mp3" start="0" end="2.27" />
    </S>
    <S id="229623">
        <FORM kindOf="original">nanu qani?</FORM>
        <FORM kindOf="standard">nanu qani?</FORM>
        <PHON kindOf="standard">nanu qani</PHON>
        <TRANSL xml:lang="zho">這是什麼?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229623.wav" url="https://web.klokah.tw/text/sound/17607/229623.mp3" start="0" end="2.12" />
    </S>
    <S id="229624">
        <FORM kindOf="original">qani ga yopun.</FORM>
        <FORM kindOf="standard">qani ga yopun.</FORM>
        <PHON kindOf="standard">qani ɣa jopun</PHON>
        <TRANSL xml:lang="zho">這是褲子。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229624.wav" url="https://web.klokah.tw/text/sound/17607/229624.mp3" start="0" end="2.77" />
    </S>
    <S id="229625">
        <FORM kindOf="original">nanu qani?</FORM>
        <FORM kindOf="standard">nanu qani?</FORM>
        <PHON kindOf="standard">nanu qani</PHON>
        <TRANSL xml:lang="zho">這是什麼?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229625.wav" url="https://web.klokah.tw/text/sound/17607/229625.mp3" start="0" end="1.88" />
    </S>
    <S id="229626">
        <FORM kindOf="original">yamin ru qbubu qani.</FORM>
        <FORM kindOf="standard">yamin ru qbubu qani.</FORM>
        <PHON kindOf="standard">jamin ru qβuβu qani</PHON>
        <TRANSL xml:lang="zho">這是鞋子和帽子。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229626.wav" url="https://web.klokah.tw/text/sound/17607/229626.mp3" start="0" end="2.68" />
    </S>
    <S id="229627">
        <FORM kindOf="original">cyux maki rgyax qalang maku,</FORM>
        <FORM kindOf="standard">cyux maki rgyax qalang maku,</FORM>
        <PHON kindOf="standard">[ʦ|ʨ]jux maki rɣjax qalaŋ maku</PHON>
        <TRANSL xml:lang="zho">我的部落位於深山中，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229627.wav" url="https://web.klokah.tw/text/sound/17608/229627.mp3" start="0" end="3.79" />
    </S>
    <S id="229628">
        <FORM kindOf="original">cingay balay qulih ru qsinuw nya,</FORM>
        <FORM kindOf="standard">cingay balay qulih ru qsinuw nya,</FORM>
        <PHON kindOf="standard">[ʦ|ʨ]iŋaj βalaj quliħ ru q[s|ɕ]inuw nja</PHON>
        <TRANSL xml:lang="zho">有很多的溪魚和山產，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229628.wav" url="https://web.klokah.tw/text/sound/17608/229628.mp3" start="0" end="4.41" />
    </S>
    <S id="229629">
        <FORM kindOf="original">wah cisan qalang maku.</FORM>
        <FORM kindOf="standard">wah cisan qalang maku.</FORM>
        <PHON kindOf="standard">waħ [ʦ|ʨ]i[s|ɕ]an qalaŋ maku</PHON>
        <TRANSL xml:lang="zho">歡迎光臨我的部落。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229629.wav" url="https://web.klokah.tw/text/sound/17608/229629.mp3" start="0" end="2.98" />
    </S>
    <S id="229630">
        <FORM kindOf="original">syaw ngasal maku ga, kya qutux hopa balay na qhuniq.</FORM>
        <FORM kindOf="standard">syaw ngasal maku ga, kya qutux hopa balay na qhuniq.</FORM>
        <PHON kindOf="standard">[s|ɕ]jaw ŋa[s|ɕ]al maku ɣa kja qutux ħopa βalaj na qħuniq</PHON>
        <TRANSL xml:lang="zho">在我們家旁邊有一棵大樹。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229630.wav" url="https://web.klokah.tw/text/sound/17609/229630.mp3" start="0" end="7.97" />
    </S>
    <S id="229631">
        <FORM kindOf="original">nanu cyux maki yatux qhuniq? yapic cyux maki yatux qhuniq.</FORM>
        <FORM kindOf="standard">nanu cyux maki yatux qhuniq? yapic cyux maki yatux qhuniq.</FORM>
        <PHON kindOf="standard">nanu [ʦ|ʨ]jux maki jatux qħuniq japi[ʦ|ʨ] [ʦ|ʨ]jux maki jatux qħuniq</PHON>
        <TRANSL xml:lang="zho">大樹上有什麼?大樹上有飛鼠。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229631.wav" url="https://web.klokah.tw/text/sound/17609/229631.mp3" start="0" end="7.91" />
    </S>
    <S id="229632">
        <FORM kindOf="original">nanu cyux maki yatux qhuniq? yungay cyux maki yatux qhuniq.</FORM>
        <FORM kindOf="standard">nanu cyux maki yatux qhuniq? yungay cyux maki yatux qhuniq.</FORM>
        <PHON kindOf="standard">nanu [ʦ|ʨ]jux maki jatux qħuniq juŋaj [ʦ|ʨ]jux maki jatux qħuniq</PHON>
        <TRANSL xml:lang="zho">大樹上有什麼?大樹上有猴子。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229632.wav" url="https://web.klokah.tw/text/sound/17609/229632.mp3" start="0" end="7.97" />
    </S>
    <S id="229633">
        <FORM kindOf="original">nanu cyux maki yatux qhuniq? qhnyaq cyux maki yatux qhuniq.</FORM>
        <FORM kindOf="standard">nanu cyux maki yatux qhuniq? qhnyaq cyux maki yatux qhuniq.</FORM>
        <PHON kindOf="standard">nanu [ʦ|ʨ]jux maki jatux qħuniq qħnjaq [ʦ|ʨ]jux maki jatux qħuniq</PHON>
        <TRANSL xml:lang="zho">大樹上有什麼?大樹上有小鳥。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229633.wav" url="https://web.klokah.tw/text/sound/17609/229633.mp3" start="0" end="8.1" />
    </S>
    <S id="229634">
        <FORM kindOf="original">kyalun saku yaba.</FORM>
        <FORM kindOf="standard">kyalun saku yaba.</FORM>
        <PHON kindOf="standard">kjalun [s|ɕ]aku jaβa</PHON>
        <TRANSL xml:lang="zho">我告訴爸爸說，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229634.wav" url="https://web.klokah.tw/text/sound/17610/229634.mp3" start="0" end="1.87" />
    </S>
    <S id="229635">
        <FORM kindOf="original">hata lngyaq syaw llyung.</FORM>
        <FORM kindOf="standard">hata lngyaq syaw llyung.</FORM>
        <PHON kindOf="standard">ħata lŋjaq [s|ɕ]jaw lljuŋ</PHON>
        <TRANSL xml:lang="zho">我們到河邊去戲水好嗎?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229635.wav" url="https://web.klokah.tw/text/sound/17610/229635.mp3" start="0" end="3.0" />
    </S>
    <S id="229636">
        <FORM kindOf="original">pngan saku na yaba mu ru tehoq sami syaw llyung la.</FORM>
        <FORM kindOf="standard">pngan saku na yaba mu ru tehoq sami syaw llyung la.</FORM>
        <PHON kindOf="standard">pŋan [s|ɕ]aku na jaβa mu ru teħoq [s|ɕ]ami [s|ɕ]jaw lljuŋ la</PHON>
        <TRANSL xml:lang="zho">爸爸就背著我來到小河邊，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229636.wav" url="https://web.klokah.tw/text/sound/17610/229636.mp3" start="0" end="6.95" />
    </S>
    <S id="229637">
        <FORM kindOf="original">tltuw balay qsya nya!</FORM>
        <FORM kindOf="standard">tltuw balay qsya nya!</FORM>
        <PHON kindOf="standard">tltuw βalaj q[s|ɕ]ja nja</PHON>
        <TRANSL xml:lang="zho">好清涼的溪水啊!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229637.wav" url="https://web.klokah.tw/text/sound/17610/229637.mp3" start="0" end="3.03" />
    </S>
    <S id="229638">
        <FORM kindOf="original">sbing balay qsya nya!</FORM>
        <FORM kindOf="standard">sbing balay qsya nya!</FORM>
        <PHON kindOf="standard">[s|ɕ]βiŋ βalaj q[s|ɕ]ja nja</PHON>
        <TRANSL xml:lang="zho">好甘甜的溪水啊!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229638.wav" url="https://web.klokah.tw/text/sound/17610/229638.mp3" start="0" end="3.21" />
    </S>
    <S id="229639">
        <FORM kindOf="original">mpanga na kiri yaki.</FORM>
        <FORM kindOf="standard">mpanga na kiri yaki.</FORM>
        <PHON kindOf="standard">mpaŋa na kiri jaki</PHON>
        <TRANSL xml:lang="zho">祖母背著背簍，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229639.wav" url="https://web.klokah.tw/text/sound/17611/229639.mp3" start="0" end="3.53" />
    </S>
    <S id="229640">
        <FORM kindOf="original">kya trakis kiri nya.</FORM>
        <FORM kindOf="standard">kya trakis kiri nya.</FORM>
        <PHON kindOf="standard">kja traki[s|ɕ] kiri nja</PHON>
        <TRANSL xml:lang="zho">背簍裡有小米，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229640.wav" url="https://web.klokah.tw/text/sound/17611/229640.mp3" start="0" end="2.95" />
    </S>
    <S id="229641">
        <FORM kindOf="original">kya singut kiri nya.</FORM>
        <FORM kindOf="standard">kya singut kiri nya.</FORM>
        <PHON kindOf="standard">kja [s|ɕ]iŋut kiri nja</PHON>
        <TRANSL xml:lang="zho">背簍裡有樹豆，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229641.wav" url="https://web.klokah.tw/text/sound/17611/229641.mp3" start="0" end="2.93" />
    </S>
    <S id="229642">
        <FORM kindOf="original">blaq balay niqun trakis ru singut.</FORM>
        <FORM kindOf="standard">blaq balay niqun trakis ru singut.</FORM>
        <PHON kindOf="standard">βlaq βalaj niqun traki[s|ɕ] ru [s|ɕ]iŋut</PHON>
        <TRANSL xml:lang="zho">小米和樹豆都非常好吃。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229642.wav" url="https://web.klokah.tw/text/sound/17611/229642.mp3" start="0" end="5.02" />
    </S>
    <S id="229643">
        <FORM kindOf="original">pongan ke na bnkis raran.</FORM>
        <FORM kindOf="standard">pongan ke na bnkis raran.</FORM>
        <PHON kindOf="standard">poŋan ke na βnki[s|ɕ] raran</PHON>
        <TRANSL xml:lang="zho">聽從前的老人家說過，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229643.wav" url="https://web.klokah.tw/text/sound/17612/229643.mp3" start="0" end="4.49" />
    </S>
    <S id="229644">
        <FORM kindOf="original">kya qutux hopa balay tunux.</FORM>
        <FORM kindOf="standard">kya qutux hopa balay tunux.</FORM>
        <PHON kindOf="standard">kja qutux ħopa βalaj tunux</PHON>
        <TRANSL xml:lang="zho">有一顆很巨大的岩石，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229644.wav" url="https://web.klokah.tw/text/sound/17612/229644.mp3" start="0" end="3.6" />
    </S>
    <S id="229645">
        <FORM kindOf="original">cyux surux beh syaw na pinsbkan.</FORM>
        <FORM kindOf="standard">cyux surux beh syaw na pinsbkan.</FORM>
        <PHON kindOf="standard">[ʦ|ʨ]jux [s|ɕ]urux βeħ [s|ɕ]jaw na pin[s|ɕ]βkan</PHON>
        <TRANSL xml:lang="zho">目前正矗立在瑞岩部落邊(南投縣仁愛鄉力行村)</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229645.wav" url="https://web.klokah.tw/text/sound/17612/229645.mp3" start="0" end="4.26" />
    </S>
    <S id="229646">
        <FORM kindOf="original">tunux qani ga puqin na Tayal.</FORM>
        <FORM kindOf="standard">tunux qani ga puqin na Tayal.</FORM>
        <PHON kindOf="standard">tunux qani ɣa puqin na tajal</PHON>
        <TRANSL xml:lang="zho">這顆岩石是泰雅族的起源。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229646.wav" url="https://web.klokah.tw/text/sound/17612/229646.mp3" start="0" end="4.6" />
    </S>
    <S id="229647">
        <FORM kindOf="original">masoq hopa qwalax.</FORM>
        <FORM kindOf="standard">masoq hopa qwalax.</FORM>
        <PHON kindOf="standard">ma[s|ɕ]oq ħopa qwalax</PHON>
        <TRANSL xml:lang="zho">大雨停止了，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229647.wav" url="https://web.klokah.tw/text/sound/17613/229647.mp3" start="0" end="2.98" />
    </S>
    <S id="229648">
        <FORM kindOf="original">hmtuw wagi lga.</FORM>
        <FORM kindOf="standard">hmtuw wagi lga.</FORM>
        <PHON kindOf="standard">ħmtuw waɣi lɣa</PHON>
        <TRANSL xml:lang="zho">等到太陽出現時，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229648.wav" url="https://web.klokah.tw/text/sound/17613/229648.mp3" start="0" end="2.69" />
    </S>
    <S id="229649">
        <FORM kindOf="original">blaq utux ta ga,</FORM>
        <FORM kindOf="standard">blaq utux ta ga,</FORM>
        <PHON kindOf="standard">βlaq utux ta ɣa</PHON>
        <TRANSL xml:lang="zho">咱們的運氣好的話，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229649.wav" url="https://web.klokah.tw/text/sound/17613/229649.mp3" start="0" end="2.69" />
    </S>
    <S id="229650">
        <FORM kindOf="original">musa ta ktan hongu na utux.</FORM>
        <FORM kindOf="standard">musa ta ktan hongu na utux.</FORM>
        <PHON kindOf="standard">mu[s|ɕ]a ta ktan ħoŋu na utux</PHON>
        <TRANSL xml:lang="zho">咱們即將會看見彩虹。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229650.wav" url="https://web.klokah.tw/text/sound/17613/229650.mp3" start="0" end="5.02" />
    </S>
    <S id="229651">
        <FORM kindOf="original">qoli ga qoli.</FORM>
        <FORM kindOf="standard">qoli ga qoli.</FORM>
        <PHON kindOf="standard">qoli ɣa qoli</PHON>
        <TRANSL xml:lang="zho">老鼠呀老鼠。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229651.wav" url="https://web.klokah.tw/text/sound/17614/229651.mp3" start="0" end="2.59" />
    </S>
    <S id="229652">
        <FORM kindOf="original">mswa su kwan balay.</FORM>
        <FORM kindOf="standard">mswa su kwan balay.</FORM>
        <PHON kindOf="standard">m[s|ɕ]wa [s|ɕ]u kwan βalaj</PHON>
        <TRANSL xml:lang="zho">為什麼你那麼膽小。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229652.wav" url="https://web.klokah.tw/text/sound/17614/229652.mp3" start="0" end="2.9" />
    </S>
    <S id="229653">
        <FORM kindOf="original">qoli ga qoli.</FORM>
        <FORM kindOf="standard">qoli ga qoli.</FORM>
        <PHON kindOf="standard">qoli ɣa qoli</PHON>
        <TRANSL xml:lang="zho">老鼠呀老鼠。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229653.wav" url="https://web.klokah.tw/text/sound/17614/229653.mp3" start="0" end="2.4" />
    </S>
    <S id="229654">
        <FORM kindOf="original">mswa cipoq balay rozyaq su.</FORM>
        <FORM kindOf="standard">mswa cipoq balay rozyaq su.</FORM>
        <PHON kindOf="standard">m[s|ɕ]wa [ʦ|ʨ]ipoq βalaj rozjaq [s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">為什麼你的眼睛總是那麼小。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229654.wav" url="https://web.klokah.tw/text/sound/17614/229654.mp3" start="0" end="3.19" />
    </S>
    <S id="229655">
        <FORM kindOf="original">qoli ga qoli.</FORM>
        <FORM kindOf="standard">qoli ga qoli.</FORM>
        <PHON kindOf="standard">qoli ɣa qoli</PHON>
        <TRANSL xml:lang="zho">老鼠呀老鼠。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229655.wav" url="https://web.klokah.tw/text/sound/17614/229655.mp3" start="0" end="2.27" />
    </S>
    <S id="229656">
        <FORM kindOf="original">mswa qruyux balay ngungu su.</FORM>
        <FORM kindOf="standard">mswa qruyux balay ngungu su.</FORM>
        <PHON kindOf="standard">m[s|ɕ]wa qrujux βalaj ŋuŋu [s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">為什麼你的尾巴會那麼長呢。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229656.wav" url="https://web.klokah.tw/text/sound/17614/229656.mp3" start="0" end="3.55" />
    </S>
    <S id="229657">
        <FORM kindOf="original">qoli ga qoli.</FORM>
        <FORM kindOf="standard">qoli ga qoli.</FORM>
        <PHON kindOf="standard">qoli ɣa qoli</PHON>
        <TRANSL xml:lang="zho">老鼠呀老鼠。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229657.wav" url="https://web.klokah.tw/text/sound/17614/229657.mp3" start="0" end="2.48" />
    </S>
    <S id="229658">
        <FORM kindOf="original">laxi uwah quryaq maniq qaya ngasal ku ma?</FORM>
        <FORM kindOf="standard">laxi uwah quryaq maniq qaya ngasal ku ma?</FORM>
        <PHON kindOf="standard">laxi uwaħ qurjaq maniq qaja ŋa[s|ɕ]al ku ma</PHON>
        <TRANSL xml:lang="zho">不要再到我們家偷吃東西了好嗎?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229658.wav" url="https://web.klokah.tw/text/sound/17614/229658.mp3" start="0" end="4.78" />
    </S>
    <S id="229659">
        <FORM kindOf="original">baq qmaluq qu mlikuy na Tayal.</FORM>
        <FORM kindOf="standard">baq qmaluq qu mlikuy na Tayal.</FORM>
        <PHON kindOf="standard">βaq qmaluq qu mlikuj na tajal</PHON>
        <TRANSL xml:lang="zho">泰雅男人會打獵，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229659.wav" url="https://web.klokah.tw/text/sound/17615/229659.mp3" start="0" end="4.7" />
    </S>
    <S id="229660">
        <FORM kindOf="original">baq tminun qu knerin na Tayal.</FORM>
        <FORM kindOf="standard">baq tminun qu knerin na Tayal.</FORM>
        <PHON kindOf="standard">βaq tminun qu knerin na tajal</PHON>
        <TRANSL xml:lang="zho">泰雅女人會織布，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229660.wav" url="https://web.klokah.tw/text/sound/17615/229660.mp3" start="0" end="4.05" />
    </S>
    <S id="229661">
        <FORM kindOf="original">yasa baqun ptasan la.</FORM>
        <FORM kindOf="standard">yasa baqun ptasan la.</FORM>
        <PHON kindOf="standard">ja[s|ɕ]a βaqun pta[s|ɕ]an la</PHON>
        <TRANSL xml:lang="zho">就可以紋面。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229661.wav" url="https://web.klokah.tw/text/sound/17615/229661.mp3" start="0" end="3.27" />
    </S>
    <S id="229662">
        <FORM kindOf="original">pongan ke na bnkis qalang ga.</FORM>
        <FORM kindOf="standard">pongan ke na bnkis qalang ga.</FORM>
        <PHON kindOf="standard">poŋan ke na βnki[s|ɕ] qalaŋ ɣa</PHON>
        <TRANSL xml:lang="zho">聽過部落的老人家說過，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229662.wav" url="https://web.klokah.tw/text/sound/17616/229662.mp3" start="0" end="4.08" />
    </S>
    <S id="229663">
        <FORM kindOf="original">raran ga kya sazing wagi ma.</FORM>
        <FORM kindOf="standard">raran ga kya sazing wagi ma.</FORM>
        <PHON kindOf="standard">raran ɣa kja [s|ɕ]aziŋ waɣi ma</PHON>
        <TRANSL xml:lang="zho">從前我們部落有兩個太陽，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229663.wav" url="https://web.klokah.tw/text/sound/17616/229663.mp3" start="0" end="3.87" />
    </S>
    <S id="229664">
        <FORM kindOf="original">yasa kilux balay krryax pi.</FORM>
        <FORM kindOf="standard">yasa kilux balay krryax pi.</FORM>
        <PHON kindOf="standard">ja[s|ɕ]a kilux βalaj krrjax pi</PHON>
        <TRANSL xml:lang="zho">所以每天都非常的炎熱，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229664.wav" url="https://web.klokah.tw/text/sound/17616/229664.mp3" start="0" end="4.41" />
    </S>
    <S id="229665">
        <FORM kindOf="original">wahan nha mu qutux lga.</FORM>
        <FORM kindOf="standard">wahan nha mu qutux lga.</FORM>
        <PHON kindOf="standard">waħan nħa mu qutux lɣa</PHON>
        <TRANSL xml:lang="zho">後來他們去射下一個以後，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229665.wav" url="https://web.klokah.tw/text/sound/17616/229665.mp3" start="0" end="3.89" />
    </S>
    <S id="229666">
        <FORM kindOf="original">thay mya misu qani la.</FORM>
        <FORM kindOf="standard">thay mya misu qani la.</FORM>
        <PHON kindOf="standard">tħaj mja mi[s|ɕ]u qani la</PHON>
        <TRANSL xml:lang="zho">就剩下像現在這樣了。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Sekolik_Atayal_229666.wav" url="https://web.klokah.tw/text/sound/17616/229666.mp3" start="0" end="3.47" />
    </S>
</TEXT>