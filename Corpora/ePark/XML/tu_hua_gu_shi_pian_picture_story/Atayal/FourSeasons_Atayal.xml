<TEXT id="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal" xml:lang="tay" source="圖畫故事篇 FourSeasons_Atayal" audio="diarized" copyright="CC-BY-NC-SA" citation="Indigenous Languages Research and Development Foundation. (2020). 族語E樂園. https://web.klokah.tw/" BibTeX_citation="@misc{ePark, author = {Indigenous Languages Research and Development Foundation}, title = {族語E樂園}, year = {2020}, url = {https://web.klokah.tw/} }" glottocode="" dialect="FourSeasons">
    <S id="250695">
        <FORM kindOf="original">tuliq la!</FORM>
        <FORM kindOf="standard">tuliq la!</FORM>
        <PHON kindOf="standard">tuliq la</PHON>
        <TRANSL xml:lang="zho">起來了!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250695.wav" url="https://web.klokah.tw/text/sound/18072/250695.mp3" start="0" end="1.25" />
    </S>
    <S id="250696">
        <FORM kindOf="original">kugus pniq su,</FORM>
        <FORM kindOf="standard">kugus pniq su,</FORM>
        <PHON kindOf="standard">kuɣu[s|ɕ] pniq [s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">刷刷你的牙齒，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250696.wav" url="https://web.klokah.tw/text/sound/18072/250696.mp3" start="0" end="1.78" />
    </S>
    <S id="250697">
        <FORM kindOf="original">pima rqenas su,</FORM>
        <FORM kindOf="standard">pima rqenas su,</FORM>
        <PHON kindOf="standard">pima rqena[s|ɕ] [s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">洗洗你的臉，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250697.wav" url="https://web.klokah.tw/text/sound/18072/250697.mp3" start="0" end="1.8" />
    </S>
    <S id="250698">
        <FORM kindOf="original">pkusiy lukus su uyi.</FORM>
        <FORM kindOf="standard">pkusiy lukus su uyi.</FORM>
        <PHON kindOf="standard">pku[s|ɕ]ij luku[s|ɕ] [s|ɕ]u uji</PHON>
        <TRANSL xml:lang="zho">也穿上你的衣服吧。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250698.wav" url="https://web.klokah.tw/text/sound/18072/250698.mp3" start="0" end="2.61" />
    </S>
    <S id="250703">
        <FORM kindOf="original">maniq la,</FORM>
        <FORM kindOf="standard">maniq la,</FORM>
        <PHON kindOf="standard">maniq la</PHON>
        <TRANSL xml:lang="zho">吃飯了!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250703.wav" url="https://web.klokah.tw/text/sound/18074/250703.mp3" start="0" end="1.25" />
    </S>
    <S id="250704">
        <FORM kindOf="original">cyan ngahi ryax coni,</FORM>
        <FORM kindOf="standard">cyan ngahi ryax coni,</FORM>
        <PHON kindOf="standard">[ʦ|ʨ]jan ŋaħi rjax [ʦ|ʨ]oni</PHON>
        <TRANSL xml:lang="zho">今天有地瓜，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250704.wav" url="https://web.klokah.tw/text/sound/18074/250704.mp3" start="0" end="2.14" />
    </S>
    <S id="250705">
        <FORM kindOf="original">cyan ayang yahux sbalay uyi,</FORM>
        <FORM kindOf="standard">cyan ayang yahux sbalay uyi,</FORM>
        <PHON kindOf="standard">[ʦ|ʨ]jan ajaŋ jaħux [s|ɕ]βalaj uji</PHON>
        <TRANSL xml:lang="zho">也有龍葵湯，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250705.wav" url="https://web.klokah.tw/text/sound/18074/250705.mp3" start="0" end="2.93" />
    </S>
    <S id="250706">
        <FORM kindOf="original">blaq niqun calay.</FORM>
        <FORM kindOf="standard">blaq niqun calay.</FORM>
        <PHON kindOf="standard">βlaq niqun [ʦ|ʨ]alaj</PHON>
        <TRANSL xml:lang="zho">真是好吃。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250706.wav" url="https://web.klokah.tw/text/sound/18074/250706.mp3" start="0" end="1.8" />
    </S>
    <S id="250707">
        <FORM kindOf="original">yaya, musa cu mqas biru la,</FORM>
        <FORM kindOf="standard">yaya, musa cu mqas biru la,</FORM>
        <PHON kindOf="standard">jaja mu[s|ɕ]a [ʦ|ʨ]u mqa[s|ɕ] βiru la</PHON>
        <TRANSL xml:lang="zho">媽媽!我要去讀書，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250707.wav" url="https://web.klokah.tw/text/sound/18075/250707.mp3" start="0" end="2.98" />
    </S>
    <S id="250708">
        <FORM kindOf="original">blequn mu calay pqbaq ke na Tayal,</FORM>
        <FORM kindOf="standard">blequn mu calay pqbaq ke na Tayal,</FORM>
        <PHON kindOf="standard">βlequn mu [ʦ|ʨ]alaj pqβaq ke na tajal</PHON>
        <TRANSL xml:lang="zho">我會好好的學習泰雅語，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250708.wav" url="https://web.klokah.tw/text/sound/18075/250708.mp3" start="0" end="3.68" />
    </S>
    <S id="250709">
        <FORM kindOf="original">yunga nya, pkayan cu ke Tayal qa isu,</FORM>
        <FORM kindOf="standard">yunga nya, pkayan cu ke Tayal qa isu,</FORM>
        <PHON kindOf="standard">juŋa nja pkajan [ʦ|ʨ]u ke tajal qa i[s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">將來跟你說泰雅語，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250709.wav" url="https://web.klokah.tw/text/sound/18075/250709.mp3" start="0" end="4.05" />
    </S>
    <S id="250710">
        <FORM kindOf="original">sgagay ta.</FORM>
        <FORM kindOf="standard">sgagay ta.</FORM>
        <PHON kindOf="standard">[s|ɕ]ɣaɣaj ta</PHON>
        <TRANSL xml:lang="zho">我們再見了。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250710.wav" url="https://web.klokah.tw/text/sound/18075/250710.mp3" start="0" end="1.12" />
    </S>
    <S id="250711">
        <FORM kindOf="original">ima isu?</FORM>
        <FORM kindOf="standard">ima isu?</FORM>
        <PHON kindOf="standard">ima i[s|ɕ]u</PHON>
        <TRANSL xml:lang="zho">你是誰?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250711.wav" url="https://web.klokah.tw/text/sound/18076/250711.mp3" start="0" end="1.36" />
    </S>
    <S id="250712">
        <FORM kindOf="original">kingan ga Maray • Moqu,</FORM>
        <FORM kindOf="standard">kingan ga Maray • Moqu,</FORM>
        <PHON kindOf="standard">kiŋan ɣa maraj  moqu</PHON>
        <TRANSL xml:lang="zho">我是馬賴磨固，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250712.wav" url="https://web.klokah.tw/text/sound/18076/250712.mp3" start="0" end="2.32" />
    </S>
    <S id="250713">
        <FORM kindOf="original">isu ya?</FORM>
        <FORM kindOf="standard">isu ya?</FORM>
        <PHON kindOf="standard">i[s|ɕ]u ja</PHON>
        <TRANSL xml:lang="zho">你呢?</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250713.wav" url="https://web.klokah.tw/text/sound/18076/250713.mp3" start="0" end="0.89" />
    </S>
    <S id="250714">
        <FORM kindOf="original">Yaway • Watan qa kingan,</FORM>
        <FORM kindOf="standard">Yaway • Watan qa kingan,</FORM>
        <PHON kindOf="standard">jawaj  watan qa kiŋan</PHON>
        <TRANSL xml:lang="zho">我是雅外瓦旦，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250714.wav" url="https://web.klokah.tw/text/sound/18076/250714.mp3" start="0" end="2.8" />
    </S>
    <S id="250715">
        <FORM kindOf="original">ita qabax ga cquliq na Tayal.</FORM>
        <FORM kindOf="standard">ita qabax ga cquliq na Tayal.</FORM>
        <PHON kindOf="standard">ita qaβax ɣa [ʦ|ʨ]quliq na tajal</PHON>
        <TRANSL xml:lang="zho">我們大家是泰雅人。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250715.wav" url="https://web.klokah.tw/text/sound/18076/250715.mp3" start="0" end="3.29" />
    </S>
    <S id="250886">
        <FORM kindOf="original">maki yutas, yaki, yaba, yaya mu,</FORM>
        <FORM kindOf="standard">maki yutas, yaki, yaba, yaya mu,</FORM>
        <PHON kindOf="standard">maki juta[s|ɕ] jaki jaβa jaja mu</PHON>
        <TRANSL xml:lang="zho">我有爺爺、奶奶、爸爸和媽媽，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250886.wav" url="https://web.klokah.tw/text/sound/18078/250886.mp3" start="0" end="3.79" />
    </S>
    <S id="250887">
        <FORM kindOf="original">maki qsuyal mu mlikuy ro knerin,</FORM>
        <FORM kindOf="standard">maki qsuyal mu mlikuy ro knerin,</FORM>
        <PHON kindOf="standard">maki q[s|ɕ]ujal mu mlikuj ro knerin</PHON>
        <TRANSL xml:lang="zho">有哥哥、姐姐，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250887.wav" url="https://web.klokah.tw/text/sound/18078/250887.mp3" start="0" end="3.42" />
    </S>
    <S id="250888">
        <FORM kindOf="original">maki swahi mu mlikuy ro knerin uyi,</FORM>
        <FORM kindOf="standard">maki swahi mu mlikuy ro knerin uyi,</FORM>
        <PHON kindOf="standard">maki [s|ɕ]waħi mu mlikuj ro knerin uji</PHON>
        <TRANSL xml:lang="zho">也有弟弟、妹妹，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250888.wav" url="https://web.klokah.tw/text/sound/18078/250888.mp3" start="0" end="4.1" />
    </S>
    <S id="250889">
        <FORM kindOf="original">mqas calay qutux muyax myan qabax.</FORM>
        <FORM kindOf="standard">mqas calay qutux muyax myan qabax.</FORM>
        <PHON kindOf="standard">mqa[s|ɕ] [ʦ|ʨ]alaj qutux mujax mjan qaβax</PHON>
        <TRANSL xml:lang="zho">我們一家人全部都很快樂。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250889.wav" url="https://web.klokah.tw/text/sound/18078/250889.mp3" start="0" end="3.45" />
    </S>
    <S id="250890">
        <FORM kindOf="original">maki rgyax, maki llyung qalang mu,</FORM>
        <FORM kindOf="standard">maki rgyax, maki llyung qalang mu,</FORM>
        <PHON kindOf="standard">maki rɣjax maki lljuŋ qalaŋ mu</PHON>
        <TRANSL xml:lang="zho">我的部落有山、有河流，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250890.wav" url="https://web.klokah.tw/text/sound/18079/250890.mp3" start="0" end="3.27" />
    </S>
    <S id="250891">
        <FORM kindOf="original">maki rruma uyi,</FORM>
        <FORM kindOf="standard">maki rruma uyi,</FORM>
        <PHON kindOf="standard">maki rruma uji</PHON>
        <TRANSL xml:lang="zho">也有竹林，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250891.wav" url="https://web.klokah.tw/text/sound/18079/250891.mp3" start="0" end="2.14" />
    </S>
    <S id="250892">
        <FORM kindOf="original">piyux rramat pnuya qmayah kya,</FORM>
        <FORM kindOf="standard">piyux rramat pnuya qmayah kya,</FORM>
        <PHON kindOf="standard">pijux rramat pnuja qmajaħ kja</PHON>
        <TRANSL xml:lang="zho">田園種了很多蔬菜，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250892.wav" url="https://web.klokah.tw/text/sound/18079/250892.mp3" start="0" end="3.37" />
    </S>
    <S id="250893">
        <FORM kindOf="original">siyan mu calay qalang mu.</FORM>
        <FORM kindOf="standard">siyan mu calay qalang mu.</FORM>
        <PHON kindOf="standard">[s|ɕ]ijan mu [ʦ|ʨ]alaj qalaŋ mu</PHON>
        <TRANSL xml:lang="zho">我喜歡我們的部落。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250893.wav" url="https://web.klokah.tw/text/sound/18079/250893.mp3" start="0" end="2.25" />
    </S>
    <S id="250894">
        <FORM kindOf="original">maki qutux tyaba na btunux,</FORM>
        <FORM kindOf="standard">maki qutux tyaba na btunux,</FORM>
        <PHON kindOf="standard">maki qutux tjaβa na βtunux</PHON>
        <TRANSL xml:lang="zho">有一塊好大的巨石，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250894.wav" url="https://web.klokah.tw/text/sound/18080/250894.mp3" start="0" end="2.82" />
    </S>
    <S id="250895">
        <FORM kindOf="original">mbka laga,</FORM>
        <FORM kindOf="standard">mbka laga,</FORM>
        <PHON kindOf="standard">mβka laɣa</PHON>
        <TRANSL xml:lang="zho">破裂的時候，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250895.wav" url="https://web.klokah.tw/text/sound/18080/250895.mp3" start="0" end="1.31" />
    </S>
    <S id="250896">
        <FORM kindOf="original">wayal mhtux kya cquliq,</FORM>
        <FORM kindOf="standard">wayal mhtux kya cquliq,</FORM>
        <PHON kindOf="standard">wajal mħtux kja [ʦ|ʨ]quliq</PHON>
        <TRANSL xml:lang="zho">人就走出來，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250896.wav" url="https://web.klokah.tw/text/sound/18080/250896.mp3" start="0" end="2.8" />
    </S>
    <S id="250897">
        <FORM kindOf="original">naha ga bnhici na ita Tayal.</FORM>
        <FORM kindOf="standard">naha ga bnhici na ita Tayal.</FORM>
        <PHON kindOf="standard">naħa ɣa βnħi[ʦ|ʨ]i na ita tajal</PHON>
        <TRANSL xml:lang="zho">他們就是我們泰雅族的祖先。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250897.wav" url="https://web.klokah.tw/text/sound/18080/250897.mp3" start="0" end="3.55" />
    </S>
    <S id="250898">
        <FORM kindOf="original">saying wagi cyan maki babaw kayal,</FORM>
        <FORM kindOf="standard">saying wagi cyan maki babaw kayal,</FORM>
        <PHON kindOf="standard">[s|ɕ]ajiŋ waɣi [ʦ|ʨ]jan maki βaβaw kajal</PHON>
        <TRANSL xml:lang="zho">天上有兩個太陽，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250898.wav" url="https://web.klokah.tw/text/sound/18081/250898.mp3" start="0" end="3.45" />
    </S>
    <S id="250899">
        <FORM kindOf="original">mu' qutux wagi cquliq Tayal,</FORM>
        <FORM kindOf="standard">mu' qutux wagi cquliq Tayal,</FORM>
        <PHON kindOf="standard">muʔ qutux waɣi [ʦ|ʨ]quliq tajal</PHON>
        <TRANSL xml:lang="zho">泰雅人射一個太陽，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250899.wav" url="https://web.klokah.tw/text/sound/18081/250899.mp3" start="0" end="2.87" />
    </S>
    <S id="250900">
        <FORM kindOf="original">babaw nya laga, maki qlyan ro gbyan,</FORM>
        <FORM kindOf="standard">babaw nya laga, maki qlyan ro gbyan,</FORM>
        <PHON kindOf="standard">βaβaw nja laɣa maki qljan ro ɣβjan</PHON>
        <TRANSL xml:lang="zho">之後，有白天和晚上，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250900.wav" url="https://web.klokah.tw/text/sound/18081/250900.mp3" start="0" end="3.97" />
    </S>
    <S id="250901">
        <FORM kindOf="original">gbyan ga ktalan byaling uyi.</FORM>
        <FORM kindOf="standard">gbyan ga ktalan byaling uyi.</FORM>
        <PHON kindOf="standard">ɣβjan ɣa ktalan βjaliŋ uji</PHON>
        <TRANSL xml:lang="zho">夜裡也能看到月亮。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250901.wav" url="https://web.klokah.tw/text/sound/18081/250901.mp3" start="0" end="3.34" />
    </S>
    <S id="250902">
        <FORM kindOf="original">mlikuy ga baq qmalup ru cminun qwani,</FORM>
        <FORM kindOf="standard">mlikuy ga baq qmalup ru cminun qwani,</FORM>
        <PHON kindOf="standard">mlikuj ɣa βaq qmalup ru [ʦ|ʨ]minun qwani</PHON>
        <TRANSL xml:lang="zho">男人會打獵和藤編，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250902.wav" url="https://web.klokah.tw/text/sound/18082/250902.mp3" start="0" end="4.44" />
    </S>
    <S id="250903">
        <FORM kindOf="original">knerin ga baq cminun pala,</FORM>
        <FORM kindOf="standard">knerin ga baq cminun pala,</FORM>
        <PHON kindOf="standard">knerin ɣa βaq [ʦ|ʨ]minun pala</PHON>
        <TRANSL xml:lang="zho">女人會織布，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250903.wav" url="https://web.klokah.tw/text/sound/18082/250903.mp3" start="0" end="3.08" />
    </S>
    <S id="250904">
        <FORM kindOf="original">ro mlahang muyax uyi,</FORM>
        <FORM kindOf="standard">ro mlahang muyax uyi,</FORM>
        <PHON kindOf="standard">ro mlaħaŋ mujax uji</PHON>
        <TRANSL xml:lang="zho">也要照顧家人，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250904.wav" url="https://web.klokah.tw/text/sound/18082/250904.mp3" start="0" end="2.46" />
    </S>
    <S id="250905">
        <FORM kindOf="original">mrkyas laga baqun matas rqenas.</FORM>
        <FORM kindOf="standard">mrkyas laga baqun matas rqenas.</FORM>
        <PHON kindOf="standard">mrkja[s|ɕ] laɣa βaqun mata[s|ɕ] rqena[s|ɕ]</PHON>
        <TRANSL xml:lang="zho">成人就可以紋面。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250905.wav" url="https://web.klokah.tw/text/sound/18082/250905.mp3" start="0" end="3.84" />
    </S>
    <S id="250906">
        <FORM kindOf="original">ptyawaw ta blaq na yaw,</FORM>
        <FORM kindOf="standard">ptyawaw ta blaq na yaw,</FORM>
        <PHON kindOf="standard">ptjawaw ta βlaq na jaw</PHON>
        <TRANSL xml:lang="zho">我們來作好事，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250906.wav" url="https://web.klokah.tw/text/sound/18083/250906.mp3" start="0" end="2.53" />
    </S>
    <S id="250907">
        <FORM kindOf="original">huyay ta magal pinnqas na utux bnheci,</FORM>
        <FORM kindOf="standard">huyay ta magal pinnqas na utux bnheci,</FORM>
        <PHON kindOf="standard">ħujaj ta maɣal pinnqa[s|ɕ] na utux βnħe[ʦ|ʨ]i</PHON>
        <TRANSL xml:lang="zho">才能獲得祖先的歡喜，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_FourSeasons_Atayal_250907.wav" url="https://web.klokah.tw/text/sound/18083/250907.mp3" start="0" end="4.28" />
    </S>
    <S id="250908">
        <FORM kindOf="original">hkangi ta hongu utux bnheci laga,</FORM>
        <FORM kindOf="standard">hkangi ta hongu utux bnheci laga,</FORM>
        <PHON kindOf="standard">ħkaŋi ta ħoŋu utux βnħe[ʦ|ʨ]i laɣa</PHON>
        <TRANSL xml:lang="zho">我們走彩虹橋的時候，</TRANSL>
