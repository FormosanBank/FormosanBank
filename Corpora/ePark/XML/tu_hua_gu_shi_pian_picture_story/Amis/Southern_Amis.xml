<?xml version='1.0' encoding='utf-8'?>
<TEXT id="tu_hua_gu_shi_pian_picture_story_Southern_Amis" xml:lang="ami" source="圖畫故事篇 Southern_Amis" audio="diarized" copyright="CC-BY-NC-SA" citation="Indigenous Languages Research and Development Foundation. (2020). 族語E樂園. https://web.klokah.tw/" BibTeX_citation="@misc{ePark, author = {Indigenous Languages Research and Development Foundation}, title = {族語E樂園}, year = {2020}, url = {https://web.klokah.tw/} }" glottocode="sout2929" dialect="Southern">
    <S id="187146">
        <FORM kindOf="original">Pahavay ci Kacaw tu cacay a wacu.</FORM>
        <FORM kindOf="standard">Pahavay ci Kacaw tu cacay a wacu.</FORM>
        <PHON kindOf="standard">paħa[b|v]aj ʦi kaʦaw t[o|u] ʦaʦaj a waʦ[o|u]</PHON>
        <TRANSL xml:lang="zho">卡照養了一隻狗，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187146.wav" url="https://web.klokah.tw/text/sound/15216/187146.mp3" start="0" end="5.38" />
    </S>
    <S id="187147">
        <FORM kindOf="original">Makamelaw i lalan tu cacay a vavuy.</FORM>
        <FORM kindOf="standard">Makamelaw i lalan tu cacay a vavuy.</FORM>
        <PHON kindOf="standard">makaməɾaw i ɾaɾan t[o|u] ʦaʦaj a [b|v]a[b|v][o|u]j</PHON>
        <TRANSL xml:lang="zho">看見路上有隻豬，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187147.wav" url="https://web.klokah.tw/text/sound/15216/187147.mp3" start="0" end="6.22" />
    </S>
    <S id="187148">
        <FORM kindOf="original">Kuku'en nu wacu kira vavuy.</FORM>
        <FORM kindOf="standard">Kuku'en nu wacu kira vavuy.</FORM>
        <PHON kindOf="standard">k[o|u]k[o|u]ʡən n[o|u] waʦ[o|u] kira [b|v]a[b|v][o|u]j</PHON>
        <TRANSL xml:lang="zho">狗追著那隻豬，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187148.wav" url="https://web.klokah.tw/text/sound/15216/187148.mp3" start="0" end="4.78" />
    </S>
    <S id="187149">
        <FORM kindOf="original">Kalatan nu wacu kira vavuy.</FORM>
        <FORM kindOf="standard">Kalatan nu wacu kira vavuy.</FORM>
        <PHON kindOf="standard">kaɾatan n[o|u] waʦ[o|u] kira [b|v]a[b|v][o|u]j</PHON>
        <TRANSL xml:lang="zho">那隻豬被狗咬傷，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187149.wav" url="https://web.klokah.tw/text/sound/15216/187149.mp3" start="0" end="5.54" />
    </S>
    <S id="187150">
        <FORM kindOf="original">Mamelaw nu i kilangay a nani.</FORM>
        <FORM kindOf="standard">Mamelaw nu i kilangay a nani.</FORM>
        <PHON kindOf="standard">maməɾaw n[o|u] i kiɾaŋaj a nani</PHON>
        <TRANSL xml:lang="zho">爬在樹上貓兒看見了，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187150.wav" url="https://web.klokah.tw/text/sound/15216/187150.mp3" start="0" end="5.8" />
    </S>
    <S id="187151">
        <FORM kindOf="original">Tanutawa' sa kira nani tu vavuy.</FORM>
        <FORM kindOf="standard">Tanutawa' sa kira nani tu vavuy.</FORM>
        <PHON kindOf="standard">tan[o|u]tawaʡ sa kira nani t[o|u] [b|v]a[b|v][o|u]j</PHON>
        <TRANSL xml:lang="zho">一直笑那隻受傷的豬。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187151.wav" url="https://web.klokah.tw/text/sound/15216/187151.mp3" start="0" end="5.22" />
    </S>
    <S id="187152">
        <FORM kindOf="original">Pilalikidan a davak.</FORM>
        <FORM kindOf="standard">Pilalikidan a davak.</FORM>
        <PHON kindOf="standard">piɾaɾikidan a da[b|v]ak</PHON>
        <TRANSL xml:lang="zho">豐年祭的早上，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187152.wav" url="https://web.klokah.tw/text/sound/15217/187152.mp3" start="0" end="3.92" />
    </S>
    <S id="187153">
        <FORM kindOf="original">Silusid tunu Pangcah ci Panay aci Tipus.</FORM>
        <FORM kindOf="standard">Silusid tunu Pangcah ci Panay aci Tipus.</FORM>
        <PHON kindOf="standard">siɾ[o|u]sid t[o|u]n[o|u] paŋʦaħ ʦi panaj aʦi tip[o|u]s</PHON>
        <TRANSL xml:lang="zho">巴耐和迪布斯穿著傳統服飾，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187153.wav" url="https://web.klokah.tw/text/sound/15217/187153.mp3" start="0" end="6.16" />
    </S>
    <S id="187154">
        <FORM kindOf="original">Vangcal a melawan kuheni.</FORM>
        <FORM kindOf="standard">Vangcal a melawan kuheni.</FORM>
        <PHON kindOf="standard">[b|v]aŋʦaɾ a məɾawan k[o|u]ħəni</PHON>
        <TRANSL xml:lang="zho">她們看起來非常漂亮，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187154.wav" url="https://web.klokah.tw/text/sound/15217/187154.mp3" start="0" end="4.13" />
    </S>
    <S id="187155">
        <FORM kindOf="original">Patala tu turun atu sinavel ci ina atu waku.</FORM>
        <FORM kindOf="standard">Patala tu turun atu sinavel ci ina atu waku.</FORM>
        <PHON kindOf="standard">pataɾa t[o|u] t[o|u]r[o|u]n at[o|u] sina[b|v]əɾ ʦi ina at[o|u] wak[o|u]</PHON>
        <TRANSL xml:lang="zho">媽媽和我準備了糯米糕和很多的菜餚送去，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187155.wav" url="https://web.klokah.tw/text/sound/15217/187155.mp3" start="0" end="6.35" />
    </S>
    <S id="187156">
        <FORM kindOf="original">Maulah kami a remadiw,a misakeru.</FORM>
        <FORM kindOf="standard">Maulah kami a remadiw,a misakeru.</FORM>
        <PHON kindOf="standard">ma[o|u]ɾaħ kami a rəmadiwa misakər[o|u]</PHON>
        <TRANSL xml:lang="zho">我們很開心地唱歌跳舞。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187156.wav" url="https://web.klokah.tw/text/sound/15217/187156.mp3" start="0" end="7.0" />
    </S>
    <S id="187157">
        <FORM kindOf="original">Maratar a lemuwad ku Pangcah tu davak.</FORM>
        <FORM kindOf="standard">Maratar a lemuwad ku Pangcah tu davak.</FORM>
        <PHON kindOf="standard">maratar a ɾəm[o|u]wad k[o|u] paŋʦaħ t[o|u] da[b|v]ak</PHON>
        <TRANSL xml:lang="zho">阿美族人清晨早起，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187157.wav" url="https://web.klokah.tw/text/sound/15218/187157.mp3" start="0" end="7.37" />
    </S>
    <S id="187158">
        <FORM kindOf="original">Talasauwac a mivuting tu sakaranam.</FORM>
        <FORM kindOf="standard">Talasauwac a mivuting tu sakaranam.</FORM>
        <PHON kindOf="standard">taɾasa[o|u]waʦ a mi[b|v][o|u]tiŋ t[o|u] sakaranam</PHON>
        <TRANSL xml:lang="zho">到溪澗捕魚當早餐，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187158.wav" url="https://web.klokah.tw/text/sound/15218/187158.mp3" start="0" end="6.95" />
    </S>
    <S id="187159">
        <FORM kindOf="original">Talaumah a midateng tu sakalahuk.</FORM>
        <FORM kindOf="standard">Talaumah a midateng tu sakalahuk.</FORM>
        <PHON kindOf="standard">taɾa[o|u]maħ a midatəŋ t[o|u] sakaɾaħ[o|u]k</PHON>
        <TRANSL xml:lang="zho">到田間採野菜當午餐，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187159.wav" url="https://web.klokah.tw/text/sound/15218/187159.mp3" start="0" end="6.82" />
    </S>
    <S id="187160">
        <FORM kindOf="original">Talalutuk a midungec tu sakalavi'.</FORM>
        <FORM kindOf="standard">Talalutuk a midungec tu sakalavi'.</FORM>
        <PHON kindOf="standard">taɾaɾ[o|u]t[o|u]k a mid[o|u]ŋəʦ t[o|u] sakaɾa[b|v]iʡ</PHON>
        <TRANSL xml:lang="zho">到山上採藤心當晚餐，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187160.wav" url="https://web.klokah.tw/text/sound/15218/187160.mp3" start="0" end="6.74" />
    </S>
    <S id="187161">
        <FORM kindOf="original">I sauwac, i umah, i lutuk ku pingsiyang nu Pangcah.</FORM>
        <FORM kindOf="standard">I sauwac, i umah, i lutuk ku pingsiyang nu Pangcah.</FORM>
        <PHON kindOf="standard">i sa[o|u]waʦ i [o|u]maħ i ɾ[o|u]t[o|u]k k[o|u] piŋsijaŋ n[o|u] paŋʦaħ</PHON>
        <TRANSL xml:lang="zho">溪澗、田間、山中，都是阿美族人的冰箱，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187161.wav" url="https://web.klokah.tw/text/sound/15218/187161.mp3" start="0" end="8.88" />
    </S>
    <S id="187162">
        <FORM kindOf="original">Huvaw! Salipahaksa ku nikaurip nu Pangcah.</FORM>
        <FORM kindOf="standard">Huvaw! Salipahaksa ku nikaurip nu Pangcah.</FORM>
        <PHON kindOf="standard">ħ[o|u][b|v]aw saɾipaħaksa k[o|u] nika[o|u]rip n[o|u] paŋʦaħ</PHON>
        <TRANSL xml:lang="zho">哇!阿美族人的生活多麼快樂。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187162.wav" url="https://web.klokah.tw/text/sound/15218/187162.mp3" start="0" end="7.08" />
    </S>
    <S id="187163">
        <FORM kindOf="original">Marekuku' ku ayam, lemuwadtu ku Pangcah.</FORM>
        <FORM kindOf="standard">Marekuku' ku ayam, lemuwadtu ku Pangcah.</FORM>
        <PHON kindOf="standard">marək[o|u]k[o|u]ʡ k[o|u] ajam ɾəm[o|u]wadt[o|u] k[o|u] paŋʦaħ</PHON>
        <TRANSL xml:lang="zho">聽到公雞叫，族人就起床，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187163.wav" url="https://web.klokah.tw/text/sound/15219/187163.mp3" start="0" end="7.13" />
    </S>
    <S id="187164">
        <FORM kindOf="original">Hereksa namaranam, malingadtu a dademak.</FORM>
        <FORM kindOf="standard">Hereksa namaranam, malingadtu a dademak.</FORM>
        <PHON kindOf="standard">ħərəksa namaranam maɾiŋadt[o|u] a dadəmak</PHON>
        <TRANSL xml:lang="zho">吃過早餐，就到田裡工作，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187164.wav" url="https://web.klokah.tw/text/sound/15219/187164.mp3" start="0" end="7.42" />
    </S>
    <S id="187165">
        <FORM kindOf="original">I terung ku cidal, u kalahukantu.</FORM>
        <FORM kindOf="standard">I terung ku cidal, u kalahukantu.</FORM>
        <PHON kindOf="standard">i tər[o|u]ŋ k[o|u] ʦidaɾ [o|u] kaɾaħ[o|u]kant[o|u]</PHON>
        <TRANSL xml:lang="zho">日正當中，即是午餐時候，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187165.wav" url="https://web.klokah.tw/text/sound/15219/187165.mp3" start="0" end="6.87" />
    </S>
    <S id="187166">
        <FORM kindOf="original">Mucerem ku cidal, u katalumaantu.</FORM>
        <FORM kindOf="standard">Mucerem ku cidal, u katalumaantu.</FORM>
        <PHON kindOf="standard">m[o|u]ʦərəm k[o|u] ʦidaɾ [o|u] kataɾ[o|u]maant[o|u]</PHON>
        <TRANSL xml:lang="zho">日落西山，準備回家休息，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187166.wav" url="https://web.klokah.tw/text/sound/15219/187166.mp3" start="0" end="6.27" />
    </S>
    <S id="187167">
        <FORM kindOf="original">U malalukay a tamdaw ku Pangcah.</FORM>
        <FORM kindOf="standard">U malalukay a tamdaw ku Pangcah.</FORM>
        <PHON kindOf="standard">[o|u] maɾaɾ[o|u]kaj a tamdaw k[o|u] paŋʦaħ</PHON>
        <TRANSL xml:lang="zho">阿美族人是勤奮的民族。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187167.wav" url="https://web.klokah.tw/text/sound/15219/187167.mp3" start="0" end="5.75" />
    </S>
    <S id="187168">
        <FORM kindOf="original">Talaliyal a mivuting ci yama nu maku.</FORM>
        <FORM kindOf="standard">Talaliyal a mivuting ci yama nu maku.</FORM>
        <PHON kindOf="standard">taɾaɾijaɾ a mi[b|v][o|u]tiŋ ʦi jama n[o|u] mak[o|u]</PHON>
        <TRANSL xml:lang="zho">我的爸爸出海捕魚去，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187168.wav" url="https://web.klokah.tw/text/sound/15220/187168.mp3" start="0" end="4.88" />
    </S>
    <S id="187169">
        <FORM kindOf="original">Adihay ku niyala tu vuting, urang atu kalang.</FORM>
        <FORM kindOf="standard">Adihay ku niyala tu vuting, urang atu kalang.</FORM>
        <PHON kindOf="standard">adiħaj k[o|u] nijaɾa t[o|u] [b|v][o|u]tiŋ [o|u]raŋ at[o|u] kaɾaŋ</PHON>
        <TRANSL xml:lang="zho">捕到許多魚、蝦和蟹，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187169.wav" url="https://web.klokah.tw/text/sound/15220/187169.mp3" start="0" end="7.65" />
    </S>
    <S id="187170">
        <FORM kindOf="original">Maulah ci ina a makamelaw.</FORM>
        <FORM kindOf="standard">Maulah ci ina a makamelaw.</FORM>
        <PHON kindOf="standard">ma[o|u]ɾaħ ʦi ina a makaməɾaw</PHON>
        <TRANSL xml:lang="zho">媽媽看了很開心，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187170.wav" url="https://web.klokah.tw/text/sound/15220/187170.mp3" start="0" end="4.28" />
    </S>
    <S id="187171">
        <FORM kindOf="original">Tanutawasa ci vaki aci vayi.</FORM>
        <FORM kindOf="standard">Tanutawasa ci vaki aci vayi.</FORM>
        <PHON kindOf="standard">tan[o|u]tawasa ʦi [b|v]aki aʦi [b|v]aji</PHON>
        <TRANSL xml:lang="zho">爺爺奶奶笑哈哈，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187171.wav" url="https://web.klokah.tw/text/sound/15220/187171.mp3" start="0" end="4.91" />
    </S>
    <S id="187172">
        <FORM kindOf="original">U kasenengan nu maku ci yama.</FORM>
        <FORM kindOf="standard">U kasenengan nu maku ci yama.</FORM>
        <PHON kindOf="standard">[o|u] kasənəŋan n[o|u] mak[o|u] ʦi jama</PHON>
        <TRANSL xml:lang="zho">我的爸爸真了不起。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187172.wav" url="https://web.klokah.tw/text/sound/15220/187172.mp3" start="0" end="4.13" />
    </S>
    <S id="187173">
        <FORM kindOf="original">Tataang ku mata nu tatakula'.</FORM>
        <FORM kindOf="standard">Tataang ku mata nu tatakula'.</FORM>
        <PHON kindOf="standard">tataaŋ k[o|u] mata n[o|u] tatak[o|u]ɾaʡ</PHON>
        <TRANSL xml:lang="zho">青蛙的眼睛大大的，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187173.wav" url="https://web.klokah.tw/text/sound/15221/187173.mp3" start="0" end="5.62" />
    </S>
    <S id="187174">
        <FORM kindOf="original">Vangcal ku sakuvad nu adipapang.</FORM>
        <FORM kindOf="standard">Vangcal ku sakuvad nu adipapang.</FORM>
        <PHON kindOf="standard">[b|v]aŋʦaɾ k[o|u] sak[o|u][b|v]ad n[o|u] adipapaŋ</PHON>
        <TRANSL xml:lang="zho">蝴蝶的翅膀真漂亮，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187174.wav" url="https://web.klokah.tw/text/sound/15221/187174.mp3" start="0" end="5.83" />
    </S>
    <S id="187175">
        <FORM kindOf="original">Raraya' ku cepi' nu pikawayay.</FORM>
        <FORM kindOf="standard">Raraya' ku cepi' nu pikawayay.</FORM>
        <PHON kindOf="standard">rarajaʡ k[o|u] ʦəpiʡ n[o|u] pikawajaj</PHON>
        <TRANSL xml:lang="zho">綠蝗的大腿長又壯，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187175.wav" url="https://web.klokah.tw/text/sound/15221/187175.mp3" start="0" end="6.09" />
    </S>
    <S id="187176">
        <FORM kindOf="original">Maulah ku dadipis a misakeru'.</FORM>
        <FORM kindOf="standard">Maulah ku dadipis a misakeru'.</FORM>
        <PHON kindOf="standard">ma[o|u]ɾaħ k[o|u] dadipis a misakər[o|u]ʡ</PHON>
        <TRANSL xml:lang="zho">蟑螂愉快地在跳舞，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187176.wav" url="https://web.klokah.tw/text/sound/15221/187176.mp3" start="0" end="5.36" />
    </S>
    <S id="187177">
        <FORM kindOf="original">Cicicisa a remadiw ku naninih.</FORM>
        <FORM kindOf="standard">Cicicisa a remadiw ku naninih.</FORM>
        <PHON kindOf="standard">ʦiʦiʦisa a rəmadiw k[o|u] naniniħ</PHON>
        <TRANSL xml:lang="zho">蟋蟀吱吱地在唱歌。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187177.wav" url="https://web.klokah.tw/text/sound/15221/187177.mp3" start="0" end="8.41" />
    </S>
    <S id="187178">
        <FORM kindOf="original">Ira ku liyal i a'ayaw nu niyaru' nu maku.</FORM>
        <FORM kindOf="standard">Ira ku liyal i a'ayaw nu niyaru' nu maku.</FORM>
        <PHON kindOf="standard">ira k[o|u] ɾijaɾ i aʡajaw n[o|u] nijar[o|u]ʡ n[o|u] mak[o|u]</PHON>
        <TRANSL xml:lang="zho">我的家鄉，前面有大海。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187178.wav" url="https://web.klokah.tw/text/sound/15222/187178.mp3" start="0" end="7.34" />
    </S>
    <S id="187179">
        <FORM kindOf="original">Ira ku lutuk i lalikul nu niyaru' nu maku.</FORM>
        <FORM kindOf="standard">Ira ku lutuk i lalikul nu niyaru' nu maku.</FORM>
        <PHON kindOf="standard">ira k[o|u] ɾ[o|u]t[o|u]k i ɾaɾik[o|u]ɾ n[o|u] nijar[o|u]ʡ n[o|u] mak[o|u]</PHON>
        <TRANSL xml:lang="zho">我的家鄉，後面有山坡。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187179.wav" url="https://web.klokah.tw/text/sound/15222/187179.mp3" start="0" end="8.31" />
    </S>
    <S id="187180">
        <FORM kindOf="original">Masadak ku cidal, lemuwad ku ayam.</FORM>
        <FORM kindOf="standard">Masadak ku cidal, lemuwad ku ayam.</FORM>
        <PHON kindOf="standard">masadak k[o|u] ʦidaɾ ɾəm[o|u]wad k[o|u] ajam</PHON>
        <TRANSL xml:lang="zho">太陽出現，鳥兒已出巢。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187180.wav" url="https://web.klokah.tw/text/sound/15222/187180.mp3" start="0" end="8.02" />
    </S>
    <S id="187181">
        <FORM kindOf="original">Mucerem ku cidal, taluma' ku ayam i dipung.</FORM>
        <FORM kindOf="standard">Mucerem ku cidal, taluma' ku ayam i dipung.</FORM>
        <PHON kindOf="standard">m[o|u]ʦərəm k[o|u] ʦidaɾ taɾ[o|u]maʡ k[o|u] ajam i dip[o|u]ŋ</PHON>
        <TRANSL xml:lang="zho">太陽下山，鳥兒也歸巢。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187181.wav" url="https://web.klokah.tw/text/sound/15222/187181.mp3" start="0" end="7.5" />
    </S>
    <S id="187182">
        <FORM kindOf="original">Maherek namicudad tu cacudaden i laviyi'.</FORM>
        <FORM kindOf="standard">Maherek namicudad tu cacudaden i laviyi'.</FORM>
        <PHON kindOf="standard">maħərək namiʦ[o|u]dad t[o|u] ʦaʦ[o|u]dadən i ɾa[b|v]ijiʡ</PHON>
        <TRANSL xml:lang="zho">家庭課業在夜裡完成。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187182.wav" url="https://web.klokah.tw/text/sound/15222/187182.mp3" start="0" end="7.58" />
    </S>
    <S id="187183">
        <FORM kindOf="original">Pakungku ci ina i tamiyanan a malekaka.</FORM>
        <FORM kindOf="standard">Pakungku ci ina i tamiyanan a malekaka.</FORM>
        <PHON kindOf="standard">pak[o|u]ŋk[o|u] ʦi ina i tamijanan a maɾəkaka</PHON>
        <TRANSL xml:lang="zho">媽媽給我們姊妹講故事。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187183.wav" url="https://web.klokah.tw/text/sound/15222/187183.mp3" start="0" end="7.11" />
    </S>
    <S id="187184">
        <FORM kindOf="original">Misavelavelat ku vuis i kakarayan,</FORM>
        <FORM kindOf="standard">Misavelavelat ku vuis i kakarayan,</FORM>
        <PHON kindOf="standard">misa[b|v]əɾa[b|v]əɾat k[o|u] [b|v][o|u]is i kakarajan</PHON>
        <TRANSL xml:lang="zho">天上的星星閃閃發光，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187184.wav" url="https://web.klokah.tw/text/sound/15223/187184.mp3" start="0" end="6.01" />
    </S>
    <S id="187185">
        <FORM kindOf="original">Ira ku malikatay.</FORM>
        <FORM kindOf="standard">Ira ku malikatay.</FORM>
        <PHON kindOf="standard">ira k[o|u] maɾikataj</PHON>
        <TRANSL xml:lang="zho">有的明亮，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187185.wav" url="https://web.klokah.tw/text/sound/15223/187185.mp3" start="0" end="3.47" />
    </S>
    <S id="187186">
        <FORM kindOf="original">Ira ku makahemay.</FORM>
        <FORM kindOf="standard">Ira ku makahemay.</FORM>
        <PHON kindOf="standard">ira k[o|u] makaħəmaj</PHON>
        <TRANSL xml:lang="zho">有的朦朧，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187186.wav" url="https://web.klokah.tw/text/sound/15223/187186.mp3" start="0" end="3.34" />
    </S>
    <S id="187187">
        <FORM kindOf="original">Savelevelatsa ku vuis i kakarayan.</FORM>
        <FORM kindOf="standard">Savelevelatsa ku vuis i kakarayan.</FORM>
        <PHON kindOf="standard">sa[b|v]əɾə[b|v]əɾatsa k[o|u] [b|v][o|u]is i kakarajan</PHON>
        <TRANSL xml:lang="zho">天上的星星閃閃發光，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187187.wav" url="https://web.klokah.tw/text/sound/15223/187187.mp3" start="0" end="5.54" />
    </S>
    <S id="187188">
        <FORM kindOf="original">Matiya' u misakemutay nu wawa.</FORM>
        <FORM kindOf="standard">Matiya' u misakemutay nu wawa.</FORM>
        <PHON kindOf="standard">matijaʡ [o|u] misakəm[o|u]taj n[o|u] wawa</PHON>
        <TRANSL xml:lang="zho">好像淘氣的小孩。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187188.wav" url="https://web.klokah.tw/text/sound/15223/187188.mp3" start="0" end="5.15" />
    </S>
    <S id="187189">
        <FORM kindOf="original">Masatereptu ku urad.</FORM>
        <FORM kindOf="standard">Masatereptu ku urad.</FORM>
        <PHON kindOf="standard">masatərəpt[o|u] k[o|u] [o|u]rad</PHON>
        <TRANSL xml:lang="zho">雨停了!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187189.wav" url="https://web.klokah.tw/text/sound/15224/187189.mp3" start="0" end="5.02" />
    </S>
    <S id="187190">
        <FORM kindOf="original">Masadaktu ku talakal ni Adek.</FORM>
        <FORM kindOf="standard">Masadaktu ku talakal ni Adek.</FORM>
        <PHON kindOf="standard">masadakt[o|u] k[o|u] taɾakaɾ ni adək</PHON>
        <TRANSL xml:lang="zho">彩虹出現了!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187190.wav" url="https://web.klokah.tw/text/sound/15224/187190.mp3" start="0" end="4.47" />
    </S>
    <S id="187191">
        <FORM kindOf="original">Lahngangay, kulawlaway, langdaway.......</FORM>
        <FORM kindOf="standard">Lahngangay, kulawlaway, langdaway.......</FORM>
        <PHON kindOf="standard">ɾaħŋaŋaj k[o|u]ɾawɾawaj ɾaŋdawaj</PHON>
        <TRANSL xml:lang="zho">紅的、黃的、綠的...。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187191.wav" url="https://web.klokah.tw/text/sound/15224/187191.mp3" start="0" end="6.71" />
    </S>
    <S id="187192">
        <FORM kindOf="original">Uwa! Vangcal ku talakal ni Adek.</FORM>
        <FORM kindOf="standard">Uwa! Vangcal ku talakal ni Adek.</FORM>
        <PHON kindOf="standard">[o|u]wa [b|v]aŋʦaɾ k[o|u] taɾakaɾ ni adək</PHON>
        <TRANSL xml:lang="zho">哇!彩虹真的好漂亮唷!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187192.wav" url="https://web.klokah.tw/text/sound/15224/187192.mp3" start="0" end="5.09" />
    </S>
    <S id="187193">
        <FORM kindOf="original">Micael tu aluvu ci vaki aci vayi'.</FORM>
        <FORM kindOf="standard">Micael tu aluvu ci vaki aci vayi'.</FORM>
        <PHON kindOf="standard">miʦaəɾ t[o|u] aɾ[o|u][b|v][o|u] ʦi [b|v]aki aʦi [b|v]ajiʡ</PHON>
        <TRANSL xml:lang="zho">爺爺奶奶披掛著肩袋，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187193.wav" url="https://web.klokah.tw/text/sound/15225/187193.mp3" start="0" end="5.49" />
    </S>
    <S id="187194">
        <FORM kindOf="original">Ay! Ay! Ay!</FORM>
        <FORM kindOf="standard">Ay! Ay! Ay!</FORM>
        <PHON kindOf="standard">aj aj aj</PHON>
        <TRANSL xml:lang="zho">唉!唉!唉!</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187194.wav" url="https://web.klokah.tw/text/sound/15225/187194.mp3" start="0" end="2.95" />
    </S>
    <S id="187195">
        <FORM kindOf="original">Vangcal kira aluvu.</FORM>
        <FORM kindOf="standard">Vangcal kira aluvu.</FORM>
        <PHON kindOf="standard">[b|v]aŋʦaɾ kira aɾ[o|u][b|v][o|u]</PHON>
        <TRANSL xml:lang="zho">披掛肩袋方便又帥氣，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187195.wav" url="https://web.klokah.tw/text/sound/15225/187195.mp3" start="0" end="3.06" />
    </S>
    <S id="187196">
        <FORM kindOf="original">Pacumud han ni vaki aci vayi ku kamay i aluvu.</FORM>
        <FORM kindOf="standard">Pacumud han ni vaki aci vayi ku kamay i aluvu.</FORM>
        <PHON kindOf="standard">paʦ[o|u]m[o|u]d ħan ni [b|v]aki aʦi [b|v]aji k[o|u] kamaj i aɾ[o|u][b|v][o|u]</PHON>
        <TRANSL xml:lang="zho">爺爺奶奶手伸肩袋裡，</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187196.wav" url="https://web.klokah.tw/text/sound/15225/187196.mp3" start="0" end="7.13" />
    </S>
    <S id="187197">
        <FORM kindOf="original">Ira:tu ku icep i kamay nuheni.</FORM>
        <FORM kindOf="standard">Ira:tu ku icep i kamay nuheni.</FORM>
        <PHON kindOf="standard">ira:t[o|u] k[o|u] iʦəp i kamaj n[o|u]ħəni</PHON>
        <TRANSL xml:lang="zho">他們手上就有檳榔。</TRANSL>
        <AUDIO file="tu_hua_gu_shi_pian_picture_story_Southern_Amis_187197.wav" url="https://web.klokah.tw/text/sound/15225/187197.mp3" start="0" end="4.78" />
    </S>
</TEXT>