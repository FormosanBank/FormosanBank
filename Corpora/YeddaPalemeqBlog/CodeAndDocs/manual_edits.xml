        <S id="S483_1" source="https://yeddapalemeq.blogspot.com/2021/07/paiwan-every-day-483-abar-yasi.html">
            <FORM kindOf="original">liyaw a talem ni kama a abar.</FORM>
            <TRANSL xml:lang="eng">The coconut trees planted by father are a lot.</TRANSL>
            <TRANSL xml:lang="eng" ver="alt">Father plants many coconut trees.</TRANSL>
            <W id="S483_1W1">
                <FORM kindOf="original">liyaw</FORM>
                <TRANSL xml:lang="eng">many, a lot of</TRANSL>
                <M id="S483_1W1M1">
                    <FORM kindOf="original">liyaw</FORM>
                </M>
            </W>
            <W id="S483_1W2">
                <FORM kindOf="original">a</FORM>
                <TRANSL xml:lang="eng">LIG</TRANSL>
                <M id="S483_1W2M1">
                    <FORM kindOf="original">a</FORM>
                </M>
            </W>
            <W id="S483_1W3">
                <FORM kindOf="original">talem</FORM>
                <TRANSL xml:lang="eng">plant, cultivate, UV. Also considered a root form; this is the first word I find that in root form, it is in undergoer voice or patient focus.</TRANSL>
                <M id="S483_1W3M1">
                    <FORM kindOf="original">talem</FORM>
                </M>
            </W>
            <W id="S483_1W4">
                <FORM kindOf="original">ni</FORM>
                <TRANSL xml:lang="eng">of, GEN, used to bring the subject or actor of the UV verb.</TRANSL>
                <M id="S483_1W4M1">
                    <FORM kindOf="original">ni</FORM>
                </M>
            </W>
            <W id="S483_1W5">
                <FORM kindOf="original">kama</FORM>
                <M id="S483_1W5M1">
                    <FORM kindOf="original">kama</FORM>
                </M>
            </W>
            <W id="S483_1W6">
                <FORM kindOf="original">a</FORM>
                <TRANSL xml:lang="eng">subejct case marker</TRANSL>
                <M id="S483_1W6M1">
                    <FORM kindOf="original">a</FORM>
                </M>
            </W>
            <W id="S483_1W7">
                <FORM kindOf="original">abar</FORM>
                <TRANSL xml:lang="eng">coconut trees. abar is in RF's dictionary (1982); however, in both CIP Online Paiwan Dictionary and The List of A Thousand Paiwan Vocabulary, yasi is recorded. It seems the word abar has fallen into disuse and been replaced by the loanword from Japanese やし.</TRANSL><M id="S483_1W7M1">
                    <FORM kindOf="original">abar</FORM>
                </M>
            </W>
        </S>
