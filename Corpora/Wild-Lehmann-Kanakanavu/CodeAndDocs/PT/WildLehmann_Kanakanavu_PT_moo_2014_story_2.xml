<TEXT id="WildLehmann_Kanakanavu_PT_moo_2014_story_2" xml:lang="xnb" dialect="Kanakanavu" citation="Wild, Ilka 2018, Voice and transitivity in Kanakanavu. Unpubl. PhD dissertation University of Erfurt." BibTeX_citation="@phdthesis{Wild2018Kanakanavu,author={Ilka Wild},title={Voice and transitivity in Kanakanavu},school={University of Erfurt},year={2018},note={Unpublished PhD dissertation}}" copyright="CC BY-NC 4.0" source="kanakanavu.info, &quot;Mo'o 2014 Story 2&quot;, https://kanakanavu.info/language-documentation/moo-2014-story-2.html. This story was recorded by Ilka Wild in collaboration with Elizabeth Zeitoun in March 2014 in Namasia village. The speaker is Mo'o Kangena. The site's phonetic transcription (PT) line only; not aligned to the recording.">
  <AUDIO file="2014-moo-story-2.wav"/>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_01">
    <FORM kindOf="original">una kan kanakanavu miena maɾaʦo:ʦa mata uʦaŋin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_02">
    <FORM kindOf="original">maɾaʦo: ʦu kan mata uʦaŋin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_03">
    <FORM kindOf="original">pakasi:n kan saɾonei nanakʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_04">
    <FORM kindOf="original">mupaɾa pa mapʉn vʉʔʉ misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_05">
    <FORM kindOf="original">mupaɾa kan sua uʦaŋin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_06">
    <FORM kindOf="original">umaɾa kan umapʉn vʉʔʉ mataʔunai makai kan saɾonei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_07">
    <FORM kindOf="original">kaʔan pa mustampʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_08">
    <FORM kindOf="original">maɾa pa misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_09">
    <FORM kindOf="original">makaʔʉna kan uʦaŋin mupaɾa umaɾa ma:pʉn mataʔʉnei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_10">
    <FORM kindOf="original">ʦuɾei kan saɾonei sua vouʔʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_11">
    <FORM kindOf="original">ah kaʔan pa mustampʉ mi kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_12">
    <FORM kindOf="original">mu:paɾa pa kan sua uʦaŋin ma:pʉn</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_13">
    <FORM kindOf="original">makasua ʦu makai kan saɾonei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_14">
    <FORM kindOf="original">ah nanakʉ numanei ʦu tia i:ku mapʉn misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_15">
    <FORM kindOf="original">mupaɾa kan sua saɾonei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_16">
    <FORM kindOf="original">mupaɾa kan tia ma:pʉn matapaɾi kan sua saɾonei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_17">
    <FORM kindOf="original" notes="source writes &quot;(ni-)mustakuvu&quot;; the brackets appear to mark the letters as unclear">ni-mustakuvu ʔʉnʉnei niɾa:ka</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_18">
    <FORM kindOf="original">makasi kan uʦaŋin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_19">
    <FORM kindOf="original">ah tia pokaɾin ma:nu apaʦʉɾa inia misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_20">
    <FORM kindOf="original" notes="source writes &quot;pukaɾi(n)&quot;; the brackets appear to mark the letters as unclear">pukaɾin kan inia manuin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_21">
    <FORM kindOf="original">ivatu kan manuin ʦʉmʉɾa inia</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_22">
    <FORM kindOf="original" notes="source writes &quot;nimatʃuin(?)&quot; (marked uncertain)">ah ʦuma mise:n kasu nimaʧuin misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_23">
    <FORM kindOf="original">makasua ʦu manuin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_24">
    <FORM kindOf="original">aɾiviʧi kan inia</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_25">
    <FORM kindOf="original">maka:si kan ʦaʦa:n</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_26">
    <FORM kindOf="original">maka:si kan ʦaʦa:n maka:si kan manuin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_27">
    <FORM kindOf="original">aʦuɾo: ʦumaku misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_28">
    <FORM kindOf="original">ʦumusu mi kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_29">
    <FORM kindOf="original">makasi kan inia</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_30">
    <FORM kindOf="original">ʦʉʔʉɾei kan inia manuin tinakuviɾi</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_31">
    <FORM kindOf="original">tinakuviɾi kan ʦaʦa:n ha manuin neɾaka</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_32">
    <FORM kindOf="original">ati makasua ʦu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_33">
    <FORM kindOf="original">muʦa:n ʦu kan maka ʦaʦa:n</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_34">
    <FORM kindOf="original">ah ʧina aʦu nimaʧei ʦuma mi kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_35">
    <FORM kindOf="original">makasua ʦu muʦa:n kan ha manu ʦʉmʉɾa ʦo:min</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_36">
    <FORM kindOf="original">ata kaɾa kan ha ʦo:min</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_37">
    <FORM kindOf="original">ah manu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_01_38">
    <FORM kindOf="original">te: ku manan aʦu ku neɾa:ka misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_39">
    <FORM kindOf="original">makasua ʦu muʦa:n sua manu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_40">
    <FORM kindOf="original">mutʉa kan ʦu vʉnei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_41">
    <FORM kindOf="original">patisai kan inia vʉnei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_42">
    <FORM kindOf="original">ah manu akuni patisai vʉnei apitaɾʉ misei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_43">
    <FORM kindOf="original">kaʔan kan tumatimana sua manuin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_44">
    <FORM kindOf="original" notes="source writes &quot;(mati)tsʉmʉɾa&quot;; the brackets appear to mark the letters as unclear; its normalized line lacks them">muʦa:n kan manu matiʦʉmʉɾa vʉnei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_45">
    <FORM kindOf="original">nipatisaʔʉ kan kei tia pepaʦaʔin kei kaʔan kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_46">
    <FORM kindOf="original">aɾei kan inia patakusʉ:ɾʉ sua vʉnei makai pataksʉ:ɾʉ na ɦʉʔʉɾin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_47">
    <FORM kindOf="original">taksʉɾʉ kan vʉnei na hʉʔʉɾin makai taksʉɾʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_48">
    <FORM kindOf="original">muʦa:n kan aviʧi inia makahi tanaha</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_49">
    <FORM kindOf="original">mana tia apaʦʉʔʉɾʉ:n kei ʦuʦume:n manu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_50">
    <FORM kindOf="original">aʦu vʉnei i:si misei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_51">
    <FORM kindOf="original">makasi kan tanasa</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_52">
    <FORM kindOf="original">u tinakuviɾi kan sua manu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_53">
    <FORM kindOf="original">maka:si kan ʧinein</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_54">
    <FORM kindOf="original">atian ʧi sua manu maku misa kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_55">
    <FORM kindOf="original">mua maka:si ʦʉmʉɾa manuin nimaʧei kan</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_56">
    <FORM kindOf="original">kaʔan kan tavaɾaʔʉ muɾuŋisa sua manuin</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_57">
    <FORM kindOf="original">sin aʦu sinevʉʔʉɾʉ ʦu mamia vʉnei ha na ɦʉʔʉɾin kaʔan tavaɾaʔʉ muɾuŋisa</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_58">
    <FORM kindOf="original">aɾanei ʦu inia makasua sua vanei mama:ɾaŋ kanakanavu miena sua kanakanavu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_59">
    <FORM kindOf="original">a:n kita tavaɾaʔʉ tumaniuɾʉ vʉnei i:si apitaɾʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_60">
    <FORM kindOf="original">nu tumaniuɾʉ kia vʉnei ya mana tekita a:ka</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_61">
    <FORM kindOf="original">mastan ʦu sua ŋʦou ta:mu kisʉʉn</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_62">
    <FORM kindOf="original">ne: ʦʉʔʉɾei sua ta:mu ya una kan kanakanavu nimuɾuʔuʦaŋ ta:mu misei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_63">
    <FORM kindOf="original">kaʔan kia tavaɾaʔʉ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_64">
    <FORM kindOf="original">maɾakan ku tavaɾaʔʉ isa sua nimuɾuʔuʦaŋ ta:mu misei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_65">
    <FORM kindOf="original">sua makai ɾaʔʉvaku miʧiko ya manasʉ tavaɾaʔʉ inia</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_66">
    <FORM kindOf="original" notes="source writes &quot;tumatin(a)ɾaʔʉ&quot;; the brackets appear to mark the letters as unclear; its normalized line lacks them">sua makasua sua ikita kanakanavu ya vanei kita a:n tumatinaɾaʔʉ vʉnei i:si makasua</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_story_2_2014_Moo_02_67">
    <FORM kindOf="original">puʔisia kan misei</FORM>
  </S>
</TEXT>
