  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_01">
    <FORM kindOf="original">te: ku putukeikiau soni</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_02">
    <FORM kindOf="original">a:ka ʦʉpʉŋa ku soni</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_03">
    <FORM kindOf="original">nen vanein</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_04">
    <FORM kindOf="original">akya kinpaɾa maku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_05">
    <FORM kindOf="original">nen vanein</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_06">
    <FORM kindOf="original">kan a:ka ʦʉpʉŋa ku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_07">
    <FORM kindOf="original">nen vanein a:ka ʦʉpʉŋ musu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_08">
    <FORM kindOf="original">a:ka ʦʉpʉŋa ku si akya vantuku maku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_09">
    <FORM kindOf="original">tia siaɾa maku uʦaŋ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_10">
    <FORM kindOf="original">te: ʧi manan makasua</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_11">
    <FORM kindOf="original">tokyaʔei</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_12">
    <FORM kindOf="original" notes="source writes &quot;tsu(ma)&quot; here and &quot;cu(ma)&quot; in its normalized line; the brackets appear to mark the letters as unclear">akya vantuku ʦuma maku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_13">
    <FORM kindOf="original">ʧina maku ya natuɾu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_14">
    <FORM kindOf="original" notes="source writes &quot;tsu(ma)&quot; here and &quot;cu(ma)&quot; in its normalized line; the brackets appear to mark the letters as unclear">natuɾu ʦuma maku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_15">
    <FORM kindOf="original">akya kamʉʦʉ ʦan vantuku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_2_2014_Moo_N02_16">
