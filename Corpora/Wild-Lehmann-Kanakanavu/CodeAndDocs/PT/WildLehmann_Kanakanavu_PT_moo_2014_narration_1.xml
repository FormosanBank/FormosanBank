<TEXT id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1" xml:lang="xnb" dialect="Kanakanavu" citation="Wild, Ilka 2018, Voice and transitivity in Kanakanavu. Unpubl. PhD dissertation University of Erfurt." BibTeX_citation="@phdthesis{Wild2018Kanakanavu,author={Ilka Wild},title={Voice and transitivity in Kanakanavu},school={University of Erfurt},year={2018},note={Unpublished PhD dissertation}}" copyright="CC BY-NC 4.0" source="kanakanavu.info, &quot;Mo'o 2014 Narration 1&quot;, https://kanakanavu.info/language-documentation/moo-2014-narration-1.html. This narration was recorded by Ilka Wild in collaboration with Elizabeth Zeitoun in March 2014 in Namasia village. The speaker is Mo'o Kangena. The site's phonetic transcription (PT) line only; not aligned to the recording.">
  <AUDIO file="2014-moo-narration-1.wav"/>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_01">
    <FORM kindOf="original">mia kapta:n ku ya ni-meipaʧei ku ni-papa-kaʔʉ:nʉ ku ʦau ʦamai mata paʔiʧi</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_02">
    <FORM kindOf="original">maʦaŋaʦaŋaɾa ʦu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_03">
    <FORM kindOf="original">nakai a:ka ʦʉpʉŋa ku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_04">
    <FORM kindOf="original">takaʧiʧin ku paʦʉpʉʦʉpʉŋ</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_05">
    <FORM kindOf="original">te: ʦi ku ʦu makinanu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_06">
    <FORM kindOf="original">ʔa:n ku tavaɾaʔʉ pukaɾikaɾi</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_07">
    <FORM kindOf="original">te: ʦi kita makinanu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_08">
    <FORM kindOf="original">kaʔa:n ku tavaɾaʔʉ pukaɾikaɾi</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_09">
    <FORM kindOf="original">a:ka ʦʉpʉŋa ku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_10">
    <FORM kindOf="original">makinanu misa ku</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_11">
    <FORM kindOf="original">takaʧiʧin ku paʦʉpʉʦʉpʉŋ makinanu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_12">
    <FORM kindOf="original">nuaɾi tanam ku maɾiʦuvuʦuvuŋ mamanu</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_13">
    <FORM kindOf="original">te: ku masitanam apatimana ŋuain</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_14">
    <FORM kindOf="original">te: kaɾaʔe maʦaŋaʦaŋaɾa sa kaʔa:n kaɾa</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_15">
    <FORM kindOf="original">masiɾupaŋ ku pukaɾikaɾi</FORM>
  </S>
  <S id="WildLehmann_Kanakanavu_PT_moo_2014_narration_1_2014_Moo_N01_16">
    <FORM kindOf="original">makatipitipei ŋuain makatipitipei ɾamuʦu</FORM>
  </S>
</TEXT>
